# 莱克企业商城小程序 · 后端常驻服务（systemd）
#
# 安装（以 root 执行）：
#   cp /opt/lexy-mall/deploy/lexy-mall.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now lexy-mall
#
# 查看：systemctl status lexy-mall   日志：tail -f /var/log/lexy-mall.log
# 重启：systemctl restart lexy-mall
#
# 说明：后端零第三方依赖，不需要 npm install，也不需要 pm2。
# 环境变量写在 /opt/lexy-mall/.env（由 setup-server.sh 生成，JWT_SECRET 必填）。

[Unit]
Description=LEXY Mall Backend (zero-dependency Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lexy-mall/server
EnvironmentFile=-/opt/lexy-mall/.env
# 用绝对路径：systemd 的 PATH 很窄，写 node 会找不到
ExecStart=/usr/local/bin/node index.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/lexy-mall.log
StandardError=append:/var/log/lexy-mall.log

# ── 专用低权限用户（审查 F12）──────────────────────────────────────────
# 不写 User/Group 时，systemd 会**以 root 运行** —— 虽然下面还有 NoNewPrivileges
# 等限制，但 ReadWritePaths 覆盖的整个 /opt/lexy-mall 与 /var/log 都是 root 权限，
# 一旦代码里出现任意写文件，能写的就是整份源码（不只是数据目录）。
# 这个用户由 deploy/setup-server.sh 创建；不存在时服务会起不来（有意为之：
# 「起不来」比「悄悄以 root 跑着」好排查得多）。
User=lexy
Group=lexy

# 最小权限：进程只应写数据、上传与日志三处
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# ⚠️ 收紧到**具体路径**：装修「生成代码」要写 miniprogram/config/replica.js，
#    所以只放行这一个文件所在的目录 + 数据 + 上传 + 备份，源码其它部分一律只读。
ReadWritePaths=/opt/lexy-mall/server/data /opt/lexy-mall/miniprogram/config /var/log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
