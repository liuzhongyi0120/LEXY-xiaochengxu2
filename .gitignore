# ============================================================
# 莱克企业商城小程序 · 入库排除规则
# 仓库为公开仓库，以下内容一律不入库
# ============================================================

# ---- 运行时数据（含联调用户 / 订单 / 库存 / 素材，禁止入库）----
# db.json        业务数据：用户 / 订单 / 购物车 / 地址 / 券 / 库存
# catalog.json   运营资产：商品 / 分类 / 券模板 / 店铺设置
# decorate/      装修草稿与版本快照
# uploads/       素材库上传文件
# 首次启动会由 lib/seed.js 自动重建，克隆后无需手动准备
server/data/

# ---- 内部工作目录 ----
# 回归 / 冒烟 / 抓取脚本与临时产物
.tooling/
# AI 助手工作记忆（含内部上下文，不入公开仓库）
.workbuddy/

# ---- 微信开发者工具私有配置 ----
project.private.config.json

# ---- 依赖 ----
node_modules/

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.bak
*.swp
.vscode/
.idea/
__pycache__/
*.pyc

# ---- 原始小程序包与解包产物（体积大且含第三方代码）----
*.wxapkg
unpacked/

# ---- 部署构建产物（每次部署重新打，不入库）----
deploy/.build/
