@import "styles/variables.wxss";
@import "styles/reset.wxss";

/* ---------- 通用布局 ---------- */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-base);
  overflow: hidden;
}

/* ---------- 通用文本 ---------- */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 分隔条 ---------- */
.gap {
  height: 20rpx;
}

/* ---------- 底部固定操作栏容器 ---------- */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
  /* 全屏页（含非 tabBar 页）在 iPhone 上留出 Home Indicator 安全区 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 点击态 ---------- */
/* .hover：小面积元素（文字、图标、列表项） */
.hover {
  opacity: 0.7;
}

/* .hover-lite：大面积区块（图片广告、导航格、商品卡），太深会显得闪烁 */
.hover-lite {
  opacity: 0.85;
}

/* ---------- 骨架屏 ----------
   全局只此一份：各页面只管用 .skeleton 打底，再自己加尺寸类（.sk-img 等），
   避免每个页面各写一套底色各自的「灰块」。 */
.skeleton {
  background: linear-gradient(90deg, #F2F3F5 25%, #EBEDF0 37%, #F2F3F5 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: skeleton-flow 1.4s ease infinite;
}

@keyframes skeleton-flow {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ---------- 加载态（带转圈） ---------- */
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.loading-tip .spinner {
  margin-bottom: 24rpx;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spinner-rotate 0.7s linear infinite;
}

@keyframes spinner-rotate {
  to { transform: rotate(360deg); }
}
