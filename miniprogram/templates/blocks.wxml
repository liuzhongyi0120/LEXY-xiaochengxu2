<!--
  装修区块渲染模板（首页与自定义页共用一份）

  为什么要抽出来：pages/index 与 pages/custom 的区块 markup 原本是两份手抄的副本，
  两边已经开始走样（自定义页少了 hover-class、少了图片失败兜底、少了错误处理）。
  区块类型一共 11 种，抄两份意味着「以后每加一种区块要改两个文件，漏一个就静默不渲染」。

  用法：<include src="../../templates/blocks.wxml" />
  前提：页面 data 里有 `blocks`（已过 utils/blocks.js 的 normalizeBlocks），
        并且页面 JS 实现了 onTapBlock / onTapGoods / onImgError / onGoodsImgError /
        onDoubleChange / onPickThumb。

  ⚠️ 所有跳转一律走 utils/link.js 的 openLink（tab 页要用 switchTab），
     不要在模板里直接绑 wx.navigateTo。
-->
<block wx:for="{{blocks}}" wx:key="index" wx:for-item="block" wx:for-index="index">
  <!-- 每块外面套一层带 id 的容器：电梯导航靠 #blk-N 做滚动定位（与有赞「定位到组件」同义） -->
  <view class="blk" id="blk-{{index}}">

  <!-- ============ 图片广告：轮播海报 ============ -->
  <block wx:if="{{block.type === 'swiper' && block.mode === 'poster'}}">
    <view class="block-wrap" style="padding: 0 {{block.marginRpx}}rpx;">
      <swiper
        class="sw"
        style="height: {{block.hRpx}}rpx;"
        circular
        autoplay
        interval="{{block.interval}}"
        duration="450"
        indicator-dots="{{block.indicator === 'dots'}}"
        indicator-color="rgba(255,255,255,.45)"
        indicator-active-color="#ffffff"
      >
        <swiper-item wx:for="{{block.images}}" wx:key="image" wx:for-item="img">
          <view
            class="sw-cell {{block.round ? 'round' : ''}}"
            style="padding: 0 {{block.halfGapRpx}}rpx;"
            data-link="{{img.link}}"
            bindtap="onTapBlock"
            hover-class="{{img.link ? 'hover-lite' : 'none'}}"
            hover-stay-time="80"
          >
            <image webp="{{true}}" class="bi" src="{{img.image}}" mode="aspectFill" />
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{block.indicator === 'number'}}" class="num-ind">
        <text>{{block.cur || 1}}/{{block.images.length}}</text>
      </view>
    </view>
  </block>

  <!-- ============ 图片广告：一行一个（只展示第一张） ============ -->
  <!--
    「一行一个」：每张图各占一行、纵向依次排开（有赞 image_ad 的「一行一个」就是这个形态）。
    ⚠️ 必须 wx:for 把**所有**图都画出来。早先只画 images[0] ——
       运营在一个组件里放 3 张图，真机只显示第一张，另外两张静默消失（不报错、装修台也不提示）。
       2026-10-16 复刻有赞首页时实测到的正是这个形态：页面尾部的 image_ad.9 用「一行一个」装了 3 张长图。
  -->
  <block wx:elif="{{block.type === 'swiper' && block.mode === 'single'}}">
    <view
      wx:for="{{block.images}}"
      wx:key="image"
      class="block-wrap"
      style="padding: 0 {{block.marginRpx}}rpx;"
      data-link="{{item.link}}"
      bindtap="onTapBlock"
      hover-class="{{item.link ? 'hover-lite' : 'none'}}"
      hover-stay-time="80"
    >
      <image webp="{{true}}" class="biw {{block.round ? 'round' : ''}}" src="{{item.image}}" mode="widthFix" lazy-load />
    </view>
  </block>

  <!-- ============ 图片广告：横向滑动 ============ -->
  <block wx:elif="{{block.type === 'swiper' && block.mode === 'scroll'}}">
    <view class="block-wrap" style="padding: 0 {{block.marginRpx}}rpx;">
      <scroll-view class="hscroll" scroll-x enable-flex style="height: {{block.hRpx}}rpx;">
        <image webp="{{true}}"
          wx:for="{{block.images}}"
          wx:key="image"
          class="hscroll-i {{block.round ? 'round' : ''}}"
          style="height: {{block.hRpx}}rpx; margin-right: {{block.gapRpx}}rpx;"
          src="{{item.image}}"
          mode="aspectFill"
          data-link="{{item.link}}"
          bindtap="onTapBlock"
        />
      </scroll-view>
    </view>
  </block>

  <!-- ============ 图片广告：双层轮播（主图 + 缩略图） ============ -->
  <block wx:elif="{{block.type === 'swiper' && block.mode === 'double'}}">
    <view class="block-wrap" style="padding: 0 {{block.marginRpx}}rpx;">
      <swiper
        style="height: {{block.hRpx}}rpx;"
        circular
        autoplay
        interval="{{block.interval}}"
        duration="450"
        current="{{block.dCur}}"
        bindchange="onDoubleChange"
        data-index="{{index}}"
      >
        <swiper-item wx:for="{{block.images}}" wx:key="image">
          <image webp="{{true}}"
            class="bi {{block.round ? 'round' : ''}}"
            src="{{item.image}}"
            mode="aspectFill"
            data-link="{{item.link}}"
            bindtap="onTapBlock"
          />
        </swiper-item>
      </swiper>
      <scroll-view scroll-x class="thumb-row">
        <image webp="{{true}}"
          wx:for="{{block.images}}"
          wx:key="image"
          wx:for-index="ii"
          class="thumb-i {{block.dCur === ii ? 'on' : ''}}"
          src="{{item.image}}"
          mode="aspectFill"
          data-block="{{index}}"
          data-i="{{ii}}"
          bindtap="onPickThumb"
          hover-class="hover"
          hover-stay-time="80"
        />
      </scroll-view>
    </view>
  </block>

  <!-- ============ 单张图片 ============ -->
  <view
    wx:elif="{{block.type === 'image' && !block.failed}}"
    class="block-wrap"
    style="padding: 0 {{block.marginRpx}}rpx;"
    data-link="{{block.link}}"
    bindtap="onTapBlock"
    hover-class="{{block.link ? 'hover-lite' : 'none'}}"
    hover-stay-time="80"
  >
    <image webp="{{true}}"
      class="biw {{block.round ? 'round' : ''}}"
      src="{{block.src}}"
      mode="widthFix"
      lazy-load
      data-index="{{index}}"
      binderror="onImgError"
    />
  </view>

  <!-- ============ 视频 ============ -->
  <!--
    ⚠️ 为什么要外面套一层、再叠一个播放层（2026-10-17 真机反馈：视频播放不了）
    装修台里视频区块默认「不显示控件」= controls=false，而微信 video 在 controls=false 时
    **连中间那个播放按钮都不显示**，点画面也没有任何反应 —— 真机上看到的就是「视频播不了」。
    所以：控件开着时交给原生；控件关掉时由我们自己画一个播放按钮，点击走 VideoContext 播放，
    再点一次暂停。同时开 enable-play-gesture（支持双击播放/暂停手势）。
    中间播放按钮也跟着 controls 走：controls=false 时原生那个本来就不显示，别再声明它。
  -->
  <view wx:elif="{{block.type === 'video'}}" class="block-wrap" style="padding: 0 {{block.marginRpx}}rpx;">
    <view class="bv-box {{block.round ? 'round' : ''}}" style="height: {{block.hRpx}}rpx;">
      <video
        id="bv{{index}}"
        class="bv"
        style="height: {{block.hRpx}}rpx;"
        src="{{block.src}}"
        poster="{{block.poster}}"
        object-fit="cover"
        autoplay="{{block.autoplay}}"
        muted="{{block.muted}}"
        controls="{{block.controls}}"
        loop="{{block.loop}}"
        show-center-play-btn="{{block.controls}}"
        enable-play-gesture
        data-index="{{index}}"
        bindplay="onVideoPlay"
        bindpause="onVideoPause"
        bindended="onVideoEnded"
        binderror="onVideoError"
      />
      <!--
        封面用 image 画，不用 video 的 poster：素材库里封面多是 .webp（从有赞抓的原图），
        微信 video 的 poster 对 webp 支持不稳定（真机上就是一块黑），而 image 组件支持。
        播起来之后封面撤掉，露出画面。
      -->
      <image webp="{{true}}"
        wx:if="{{block.poster && !block.played}}"
        class="bv-poster"
        src="{{block.poster}}"
        mode="aspectFill"
      />
      <view wx:if="{{!block.controls}}" class="bv-tap" data-index="{{index}}" bindtap="onVideoTap">
        <view wx:if="{{!block.playing}}" class="bv-play">
          <view class="bv-tri"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 标题文本 ============ -->
  <view
    wx:elif="{{block.type === 'title'}}"
    class="c-title"
    style="padding: {{block.padYRpx}}rpx {{block.marginRpx}}rpx; background: {{block.bg || 'transparent'}}; text-align: {{block.align}};"
    data-link="{{block.link}}"
    bindtap="onTapBlock"
    hover-class="{{block.link ? 'hover-lite' : 'none'}}"
    hover-stay-time="80"
  >
    <view class="ct-main {{block.sizeClass}} {{block.bold ? 'bold' : ''}}" style="color: {{block.color}};">{{block.text}}</view>
    <view wx:if="{{block.sub}}" class="ct-sub">{{block.sub}}</view>
  </view>

  <!-- ============ 辅助分割 ============ -->
  <view wx:elif="{{block.type === 'line'}}" style="margin: {{block.gapYRpx}}rpx 0; padding: 0 {{block.marginRpx}}rpx; background: {{block.bg || 'transparent'}};">
    <view wx:if="{{block.style === 'blank'}}" style="height: {{block.hRpx}}rpx;"></view>
    <view wx:else class="ln {{block.style}}" style="border-top-width: {{block.hRpx}}rpx; border-color: {{block.color}};"></view>
  </view>

  <!-- ============ 公告 ============ -->
  <view
    wx:elif="{{block.type === 'notice'}}"
    class="c-notice"
    style="margin: 0 {{block.marginRpx}}rpx; color: {{block.color}}; background: {{block.bg}};"
    data-link="{{block.link}}"
    bindtap="onTapBlock"
    hover-class="{{block.link ? 'hover-lite' : 'none'}}"
    hover-stay-time="80"
  >
    <text wx:if="{{block.icon}}" class="cn-icon">📢</text>
    <swiper wx:if="{{block.scroll}}" class="cn-scroll" vertical autoplay circular interval="3000">
      <swiper-item><text class="cn-text">{{block.text}}</text></swiper-item>
    </swiper>
    <text wx:else class="cn-text">{{block.text}}</text>
  </view>

  <!-- ============ 图文导航 ============ -->
  <view wx:elif="{{block.type === 'nav'}}" class="c-nav" style="background: {{block.bg}}; padding: 12rpx {{block.marginRpx}}rpx;">
    <view
      wx:for="{{block.items}}"
      wx:key="index"
      wx:for-item="it"
      class="cn-item"
      style="width: {{block.colW}}%;"
      data-link="{{it.link}}"
      bindtap="onTapBlock"
      hover-class="{{it.link ? 'hover-lite' : 'none'}}"
      hover-stay-time="80"
    >
      <image webp="{{true}}" wx:if="{{it.image}}" class="cn-i" style="width: {{block.iconRpx}}rpx; height: {{block.iconRpx}}rpx;" src="{{it.image}}" mode="aspectFit" />
      <text class="cn-t">{{it.text}}</text>
    </view>
  </view>

  <!-- ============ 魔方 ============ -->
  <view wx:elif="{{block.type === 'cube'}}" style="padding: 0 {{block.marginRpx}}rpx; background: {{block.bg}};">
    <view class="c-cube">
      <view
        wx:for="{{block.items}}"
        wx:key="index"
        wx:for-item="it"
        class="cc-cell"
        style="width: {{block.cellW}}%; padding: {{block.gapRpx}}rpx;"
        data-link="{{it.link}}"
        bindtap="onTapBlock"
        hover-class="{{it.link ? 'hover-lite' : 'none'}}"
        hover-stay-time="80"
      >
        <image webp="{{true}}" class="cc-img" src="{{it.image}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <!-- ============ 热区切图 ============ -->
  <view wx:elif="{{block.type === 'hotspot'}}" class="block-wrap" style="padding: 0 {{block.marginRpx}}rpx;">
    <view class="hs-stage" style="height: {{block.hRpx}}rpx;">
      <image webp="{{true}}" class="bi" src="{{block.src}}" mode="aspectFill" />
      <view
        wx:for="{{block.areas}}"
        wx:key="index"
        wx:for-item="a"
        class="hs-area"
        style="left: {{a.x}}%; top: {{a.y}}%; width: {{a.w}}%; height: {{a.h}}%;"
        data-link="{{a.link}}"
        bindtap="onTapBlock"
      ></view>
    </view>
  </view>

  <!-- ============ 店铺信息 ============ -->
  <view
    wx:elif="{{block.type === 'shop'}}"
    class="c-shop"
    style="background: {{block.bg}}; margin: 0 {{block.marginRpx}}rpx; text-align: {{block.align}};"
    data-link="{{block.link}}"
    bindtap="onTapBlock"
    hover-class="{{block.link ? 'hover-lite' : 'none'}}"
    hover-stay-time="80"
  >
    <image webp="{{true}}" wx:if="{{block.style === 'avatar' && block.avatar}}" class="cs-av" src="{{block.avatar}}" mode="aspectFill" />
    <view class="cs-txt">
      <text class="cs-n">{{block.name}}</text>
      <text wx:if="{{block.slogan}}" class="cs-s">{{block.slogan}}</text>
    </view>
  </view>

  <!-- ============ 商品 ============ -->
  <!-- 店铺榜单与「商品」共用同一套卡片（数据侧按销量降序，见 utils/blocks.js 的 loadGoodsData） -->
  <view wx:elif="{{block.type === 'goods' || block.type === 'shop_rank'}}" class="c-goods" style="padding: 0 {{block.marginRpx}}rpx;">
    <view wx:if="{{block.title}}" class="cg-title">{{block.title}}</view>
    <view class="cg-grid">
      <view
        wx:for="{{block.goods}}"
        wx:key="goodsId"
        wx:for-item="g"
        wx:for-index="gIndex"
        class="cg-cell"
        style="width: {{block.cellW}}%;"
        data-goods="{{g.goodsId}}"
        bindtap="onTapGoods"
        hover-class="hover-lite"
        hover-stay-time="80"
      >
        <view class="cg-card" style="background: {{block.cardBg}};">
          <image webp="{{true}}"
            wx:if="{{!g.failed}}"
            class="cg-img"
            src="{{g.image}}"
            mode="aspectFill"
            data-b="{{index}}"
            data-g="{{gIndex}}"
            binderror="onGoodsImgError"
          />
          <view wx:else class="cg-img cg-img-failed">暂无图片</view>
          <view class="cg-info">
            <view wx:if="{{block.showTitle}}" class="cg-name">{{g.name}}</view>
            <view wx:if="{{block.showPrice}}" class="cg-price">
              <text class="cg-cur">¥</text><text class="cg-num">{{g.priceText}}</text><text wx:if="{{g.originalText}}" class="cg-origin">{{g.originalText}}</text>
            </view>
            <view wx:if="{{block.showBuy}}" class="cg-buy">立即购买</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{!block.goods.length}}" class="cg-empty" bindtap="onRetryGoods" hover-class="hover-lite">{{block.goodsFailed ? '商品加载失败，点此重试' : '暂无商品'}}</view>
  </view>

  <!-- ============ 富文本 ============ -->
  <!-- 上内边距 10px / 下 0 —— 有赞 .cap-richtext 的实测值。
       缺了上内边距，首个 <p> 的 margin-top 会折叠穿透本容器，整块占位少 10px（见 index.wxss 的 .c-rich 注释）。 -->
  <view
    wx:elif="{{block.type === 'rich_text'}}"
    class="c-rich"
    style="padding: 20rpx {{block.marginRpx}}rpx 0; background: {{block.bg || 'transparent'}};"
  >
    <rich-text class="cr-body" nodes="{{block.nodes}}"></rich-text>
  </view>

  <!-- ============ 商品搜索 ============ -->
  <view wx:elif="{{block.type === 'search'}}" class="c-search" style="padding: 12rpx {{block.marginRpx}}rpx; background: {{block.bg}};">
    <view
      class="cs-box {{block.round ? 'round' : ''}}"
      style="height: {{block.hRpx}}rpx; background: {{block.boxBg}}; justify-content: {{block.align}};"
      data-mode="{{block.mode}}"
      data-link="{{block.link}}"
      bindtap="onSearchTap"
      hover-class="hover-lite"
      hover-stay-time="80"
    >
      <text class="cs-ico">🔍</text>
      <text class="cs-ph" style="color: {{block.color}};">{{block.placeholder}}</text>
      <text wx:if="{{block.scan}}" class="cs-scan" catchtap="onScanTap">⌗</text>
    </view>
  </view>

  <!-- ============ 电梯导航 ============ -->
  <view wx:elif="{{block.type === 'elevator'}}" class="c-elev" style="background: {{block.bg}}; padding: 0 {{block.marginRpx}}rpx;">
    <!-- 「全店风格」= 纯文字均分的页签条（有赞默认形态：44px、14px 文字、选中加粗换色） -->
    <view wx:if="{{block.plain && !block.dropdown}}" class="ce-plain" style="height: {{block.plainHRpx}}rpx;">
      <view
        wx:for="{{block.items}}"
        wx:key="index"
        wx:for-item="it"
        wx:for-index="ei"
        class="ce-plainitem"
        style="font-size: {{block.plainFsRpx}}rpx; color: {{block.activeIndex === ei ? block.activeColor : block.color}}; font-weight: {{block.activeIndex === ei ? '500' : '400'}};"
        data-blk="{{index}}"
        data-i="{{ei}}"
        data-target="{{it.target}}"
        bindtap="onElevatorTap"
      >{{it.text}}</view>
    </view>
    <!-- 「自定义」= 四选一标签（背景 / 圆框 / 方框 / 下划线），可横向滚动 -->
    <scroll-view wx:elif="{{!block.dropdown}}" class="ce-scroll" scroll-x enable-flex>
      <view
        wx:for="{{block.items}}"
        wx:key="index"
        wx:for-item="it"
        wx:for-index="ei"
        class="ce-tag {{block.tagStyle}} {{block.activeIndex === ei ? 'on' : ''}}"
        style="color: {{block.activeIndex === ei ? block.activeColor : block.color}};"
        data-blk="{{index}}"
        data-i="{{ei}}"
        data-target="{{it.target}}"
        bindtap="onElevatorTap"
      >{{it.text}}</view>
    </scroll-view>
    <view wx:else class="ce-drop">
      <view
        wx:for="{{block.items}}"
        wx:key="index"
        wx:for-item="it"
        wx:for-index="ei"
        class="ce-dropitem {{block.activeIndex === ei ? 'on' : ''}}"
        style="color: {{block.activeIndex === ei ? block.activeColor : block.color}};"
        data-blk="{{index}}"
        data-i="{{ei}}"
        data-target="{{it.target}}"
        bindtap="onElevatorTap"
      >{{it.text}}</view>
    </view>
  </view>

  <!-- ============ 进入店铺 ============ -->
  <view wx:elif="{{block.type === 'enter_shop'}}" class="c-btnrow" style="padding: 20rpx {{block.marginRpx}}rpx; background: {{block.bgOut || 'transparent'}}; justify-content: {{block.justify}};">
    <view
      class="cbtn {{block.round ? 'round' : ''}}"
      style="color: {{block.color}}; background: {{block.bg}};"
      data-link="{{block.link}}"
      bindtap="onTapBlock"
      hover-class="{{block.link ? 'hover-lite' : 'none'}}"
      hover-stay-time="80"
    >{{block.text}}</view>
  </view>

  <!-- ============ 在线客服 ============ -->
  <view wx:elif="{{block.type === 'service'}}" class="c-btnrow" style="padding: 20rpx {{block.marginRpx}}rpx; background: {{block.bgOut || 'transparent'}}; justify-content: {{block.justify}};">
    <button
      class="cbtn {{block.round ? 'round' : ''}}"
      style="color: {{block.color}}; background: {{block.bg}};"
      open-type="contact"
      hover-class="hover-lite"
      hover-stay-time="80"
    >{{block.text}}</button>
  </view>

  <!-- ============ 语音 ============ -->
  <view wx:elif="{{block.type === 'audio'}}" class="c-audio {{block.right ? 'right' : ''}}" style="padding: 16rpx {{block.marginRpx}}rpx;">
    <image webp="{{true}}" wx:if="{{block.avatar}}" class="ca-av" src="{{block.avatar}}" mode="aspectFill" />
    <view class="ca-bubble" style="width: {{block.widthRpx}}rpx;" data-blk="{{index}}" bindtap="onAudioTap" hover-class="hover-lite" hover-stay-time="80">
      <text wx:if="{{block.text}}" class="ca-text">{{block.text}}</text>
      <text class="ca-dur">{{block.duration}}″</text>
      <text class="ca-ico">{{block.audioPlaying ? '❚❚' : '▶'}}</text>
    </view>
  </view>

  <!-- ============ 内容卡片 ============ -->
  <view wx:elif="{{block.type === 'content_card'}}" class="c-ccard" style="padding: {{block.padYRpx}}rpx {{block.marginRpx}}rpx;">
    <view wx:if="{{block.title}}" class="cc-title">{{block.title}}</view>
    <view class="cc-grid">
      <view
        wx:for="{{block.items}}"
        wx:key="index"
        wx:for-item="it"
        wx:for-index="ci"
        class="cc-cell"
        style="width: {{block.cellW}}%; padding: {{block.gapYRpx}}rpx {{block.gapXRpx}}rpx;"
        data-link="{{it.link}}"
        bindtap="onTapBlock"
        hover-class="{{it.link ? 'hover-lite' : 'none'}}"
        hover-stay-time="80"
      >
        <view class="cc-card {{block.cardClass}} {{block.round ? 'round' : ''}}">
          <image webp="{{true}}"
            wx:if="{{block.imgAuto && it.image}}"
            class="cc-img-auto"
            src="{{it.image}}"
            mode="widthFix"
            data-index="{{index}}"
            binderror="onImgError"
          />
          <view
            wx:else
            class="cc-pic"
            style="padding-top: {{block.padTopPct}}%;{{block.fixedImgH ? ' height: ' + block.imgHRpx + 'rpx;' : ''}}"
          >
            <image webp="{{true}}" class="cc-img" src="{{it.image}}" mode="aspectFill" data-index="{{index}}" binderror="onImgError" />
          </view>
          <view class="cc-body" style="padding: {{block.titlePadYRpx}}rpx {{block.titlePadXRpx}}rpx;">
            <view
              wx:if="{{it.title}}"
              class="cc-t"
              style="font-size: {{block.titleSizeRpx}}rpx; font-weight: {{block.titleWeightCss}}; line-height: {{block.titleLhRpx}}rpx; text-align: {{block.titleAlignCss}}; color: {{block.titleColorCss}};"
            >{{it.title}}</view>
            <view wx:if="{{it.desc}}" class="cc-d">{{it.desc}}</view>
            <view wx:if="{{block.showTag || block.showRead || block.showLike}}" class="cc-meta">
              <text wx:if="{{block.showTag}}" class="cc-tag">笔记</text>
              <text wx:if="{{block.showRead}}" class="cc-m">👁 0</text>
              <text wx:if="{{block.showLike}}" class="cc-m">♡ 0</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view
      wx:if="{{block.more}}"
      class="cc-more"
      data-link="{{block.link}}"
      bindtap="onTapBlock"
      hover-class="hover-lite"
      hover-stay-time="80"
    >{{block.moreText || '查看更多'}} ›</view>
  </view>

  <!-- ============ 混合排列（对标有赞三方扩展「混合排列A」 extension-masswx-hpitemsa） ============
       结构 = 标题（副标题 + 主标题）+ 图文卡片按行错落排布。
       行由 flex-wrap 自然形成，每张卡片的宽度由 block.items[].cellW 决定（50% / 33.33%），
       与有赞「给每张卡打 w50 / w33 宽度类」是同一套口径 —— 所以半行留白行为也一致。 -->
  <view
    wx:elif="{{block.type === 'mixed_grid'}}"
    class="c-mg"
    style="background: {{block.bgCss}}; padding: {{block.padYRpx}}rpx {{block.padXRpx}}rpx;"
  >
    <view
      wx:if="{{block.hasTitle}}"
      class="mg-head"
      style="padding-top: {{block.titleGapTopRpx}}rpx; margin-bottom: {{block.titleGapBottomRpx}}rpx; text-align: {{block.titleAlignCss}};"
    >
      <view
        wx:if="{{block.subTitle}}"
        class="mg-sub"
        style="font-size: {{block.subSizeRpx}}rpx; color: {{block.subColorCss}}; font-weight: {{block.subWeightCss}};"
      >{{block.subTitle}}</view>
      <view
        wx:if="{{block.title}}"
        class="mg-title"
        style="font-size: {{block.titleSizeRpx}}rpx; color: {{block.titleColorCss}}; font-weight: {{block.titleWeightCss}};"
      >{{block.title}}</view>
    </view>

    <view class="mg-grid">
      <view
        wx:for="{{block.items}}"
        wx:key="index"
        wx:for-item="it"
        wx:for-index="ci"
        class="mg-cell"
        style="width: {{it.cellW}}%;"
        data-link="{{it.link}}"
        bindtap="onTapBlock"
        hover-class="{{it.link ? 'hover-lite' : 'none'}}"
        hover-stay-time="80"
      >
        <view
          class="mg-card {{block.cardClass}}"
          style="margin: {{block.gapRpx}}rpx; background: {{block.cardBgCss}}; border-radius: {{block.cardRadiusRpx}}rpx;{{block.animOn ? ' animation-delay: ' + it.delay + 's;' : ' animation: none;'}}"
        >
          <view
            class="mg-pic"
            style="padding-top: {{block.padTopPct}}%; border-radius: {{block.cardRadiusRpx}}rpx {{block.cardRadiusRpx}}rpx 0 0;"
          >
            <image webp="{{true}}" class="mg-img" src="{{it.image}}" mode="aspectFill" data-index="{{index}}" binderror="onImgError" />
          </view>
          <view class="mg-body" style="margin: 0 {{block.innerRpx}}rpx {{block.innerRpx}}rpx;">
            <view
              wx:if="{{it.title}}"
              class="mg-t {{block.clampTwo ? 'two' : 'one'}}"
              style="color: {{block.itemTitleColorCss}}; font-size: {{block.itemTitleSizeRpx}}rpx; font-weight: {{block.itemTitleWeightCss}}; text-align: {{block.itemTitleAlignCss}};"
            >{{it.title}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 选项卡分类（对标有赞三方扩展「选项卡Z4」 extension-massdesign-tabcatez4） ============
       结构 = 选项卡条（每项均分、选中项加粗 + 文字正下方一条 40×2 短横线）+ 当前选项卡的图文卡片。
       卡片行的「负外边距」写法见 utils/blocks.js 的同名分支：
       卡片左右内缩 = 模块左右边距（负外边距抵消掉），相邻卡片间距 = 2 × 图文外间距 ——
       **不要**改成「卡片只留内边距」，那样列间距会变成 1 倍而不是 2 倍。
       只渲染**当前**选项卡的内容：有赞那边未激活的 tabpanel 也在 DOM 里并排铺开
       （Vant 的实现方式），但对用户没有区别，全渲染反而让首屏多背几十张图。
       外层用 <block wx:for> 而不是在同一个元素上同时写 wx:for + wx:if ——
       两者同写时谁先求值在 WXML 里没有明确保证，分开写才不会「按错误的顺序过滤」。 -->
  <view
    wx:elif="{{block.type === 'tab_cate'}}"
    class="c-tc"
    style="background: {{block.bgCss}}; padding: {{block.padTopRpx}}rpx 0 {{block.padBottomRpx}}rpx; {{block.bgImgStyle}}"
  >
    <view class="tc-tabs" style="height: {{block.tabHRpx}}rpx; background: {{block.tabBgCss}};">
      <view
        wx:for="{{block.tabs}}"
        wx:key="index"
        wx:for-item="tb"
        wx:for-index="ti"
        class="tc-tab"
        data-blk="{{index}}"
        data-ti="{{ti}}"
        bindtap="onTabCateTap"
      >
        <view
          class="tc-tab-txt"
          style="font-size: {{block.tabFsRpx}}rpx; color: {{ti === block.activeTab ? block.tabFgOn : block.tabFg}}; font-weight: {{ti === block.activeTab ? '700' : '400'}};"
        >{{tb.name}}</view>
        <view
          wx:if="{{ti === block.activeTab}}"
          class="tc-tab-line"
          style="background: {{block.tabFgOn}};"
        ></view>
      </view>
    </view>

    <view class="tc-body" style="background: {{block.innerBgCss}}; padding-top: {{block.paneTopRpx}}rpx;">
      <view wx:if="{{!block.hasTabs}}" class="tc-empty">（未添加选项卡）</view>
      <block wx:for="{{block.tabs}}" wx:key="index" wx:for-item="tb" wx:for-index="ti">
        <view
          wx:if="{{ti === block.activeTab}}"
          class="tc-grid"
          style="margin: 0 {{block.padXRpx}}rpx; padding: {{block.padInnerRpx}}rpx;"
        >
          <view wx:if="{{!tb.items.length}}" class="tc-empty">（本选项卡还没有内容）</view>
          <view class="tc-row" style="margin: 0 {{block.gapNegRpx}}rpx;">
            <view
              wx:for="{{tb.items}}"
              wx:key="index"
              wx:for-item="it"
              class="tc-out"
              style="width: {{block.cellW}}%;"
            >
              <view
                class="tc-card {{block.cardClass}}"
                style="margin: {{block.gapRpx}}rpx; background: {{block.cardBgCss}}; border-radius: {{block.cardRadiusRpx}}rpx;"
                data-link="{{it.link}}"
                bindtap="onTapBlock"
                hover-class="{{it.link ? 'hover-lite' : 'none'}}"
                hover-stay-time="80"
              >
                <!-- 视频条目：图片自动当封面（有赞「添加视频」同口径） -->
                <view wx:if="{{it.video}}" class="tc-vpic">
                  <video class="tc-video" src="{{it.video}}" poster="{{it.image}}" object-fit="contain" show-center-play-btn="{{true}}" />
                </view>
                <!-- 图片比例「自适应」：按原图比例铺满整宽（有赞 width:100%; height:auto） -->
                <image webp="{{true}}"
                  wx:elif="{{block.imgAuto && it.image}}"
                  class="tc-img-auto"
                  src="{{it.image}}"
                  mode="widthFix"
                  style="border-radius: {{block.imgRadiusCss}};"
                  data-index="{{index}}"
                  binderror="onImgError"
                />
                <!-- 指定比例：用 padding-top 撑出固定高度（百分比按宽度算），图片绝对定位铺满 -->
                <view wx:elif="{{it.image}}" class="tc-pic" style="padding-top: {{block.padTopPct}}%; border-radius: {{block.imgRadiusCss}};">
                  <image webp="{{true}}"
                    class="tc-img"
                    src="{{it.image}}"
                    mode="{{block.imgFit}}"
                    data-index="{{index}}"
                    binderror="onImgError"
                  />
                </view>
                <!-- 标题：图文名称 / 标题行数 / 字号 / 加粗 / 对齐 / 上下左右间距 全部走内联 -->
                <view
                  wx:if="{{block.showTitle && it.title}}"
                  class="tc-title {{block.titleClamp === 2 ? 'two' : 'one'}}"
                  style="color: {{block.titleColorCss}}; font-size: {{block.titleFsRpx}}rpx; font-weight: {{block.titleWeightCss}}; text-align: {{block.titleAlignCss}}; margin: {{block.titleGapYRpx}}rpx {{block.titleGapXRpx}}rpx;"
                >{{it.title}}</view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- ============ 购买按钮（固定吸底） ============ -->
  <block wx:elif="{{block.type === 'buy_bar'}}">
    <!-- 占位块：吸底按钮会盖住页面内容，用它把页面底部垫高同样的高度 -->
    <view class="cb-spacer" style="height: {{block.bgHRpx}}rpx;"></view>
    <view class="c-buybar" style="height: {{block.bgHRpx}}rpx; background: {{block.bgOn ? block.bg : 'transparent'}};">
      <view class="cb-row" style="padding: 0 {{block.padXRpx}}rpx {{block.padBRpx}}rpx; justify-content: {{block.alignRight ? 'flex-end' : 'center'}};">
        <view
          class="cb-btn"
          style="height: {{block.btnHRpx}}rpx; border-radius: {{block.btnRRpx}}rpx; font-size: {{block.fontRpx}}rpx; background: {{block.btnBgFinal}};"
          data-goods="{{block.goodsId}}"
          bindtap="onBuyBarTap"
          hover-class="hover-lite"
          hover-stay-time="80"
        >{{block.text}}</view>
      </view>
    </view>
  </block>

  <!-- ============ 品牌分类（对标有赞「高级组件 · 品牌分类E」） ============ -->
  <!-- 左栏品牌导航 + 右栏图文内容；点左栏只切本地 activeBrand，不改装修数据 -->
  <view wx:elif="{{block.type === 'brand_category'}}" class="c-bcat" style="background: {{block.bgFinal}}; {{block.modBgStyle}};">

    <view class="bc-wrap">
      <!--
        左栏：品牌导航。风格 C 的竖条是绝对定位的节点，所以外层要 relative。
        用 <scroll-view> 而不是 <view>：有赞「品牌分类E」在页面里是**整屏橱窗**
        （组件高度 = 一屏，左右两栏各自内部滚动），普通 view 在小程序里无法滚动。
        高度模式 auto 时 scroll-y 传 false、高度留空 —— 行为与原来的 view 完全一致。
      -->
      <scroll-view
        class="bc-navcol {{block.screenMode ? 'screen' : ''}}"
        scroll-y="{{block.screenMode}}"
        style="width: {{block.navWidthPct}}%; background: {{block.navBgBase}};"
      >
        <view
          wx:if="{{block.navLogo}}"
          class="bc-logo"
          data-link="{{block.navLogoLink}}"
          bindtap="onTapBlock"
          hover-class="{{block.navLogoLink ? 'hover-lite' : 'none'}}"
          hover-stay-time="80"
        >
          <image webp="{{true}}" src="{{block.navLogo}}" mode="widthFix" />
        </view>
        <view wx:if="{{block.searchOn}}" class="bc-search" catchtap="onSearchTap">🔍 搜索</view>

        <view
          wx:for="{{block.navs}}"
          wx:key="index"
          wx:for-item="navText"
          wx:for-index="bi"
          class="bc-nav {{block.navIsD ? 'is-d' : ''}}"
          style="padding: {{block.navPadYRpx}}rpx 0; --bc-line: {{block.navLineColor}};"
          data-blk="{{index}}"
          data-bi="{{bi}}"
          bindtap="onBrandTap"
          hover-class="hover-lite"
          hover-stay-time="80"
        >
          <view
            class="bc-navi {{bi === block.activeBrand ? 'on' : ''}} {{block.navIsC ? 'is-c' : ''}}"
            style="height: {{block.navInnerHRpx}}rpx; border-radius: {{block.navRadiusRpx}}rpx; justify-content: {{block.navJustify}}; font-size: {{block.navFsRpx}}rpx; --bc-fg: {{block.navFgOff}}; --bc-fg-on: {{block.navFgOn}}; --bc-bg: {{block.navBgOff}}; --bc-bg-on: {{block.navBgOn}}; --bc-w: {{block.navWeightOff}}; --bc-w-on: {{block.navWeightOn}}; --bc-bar: {{block.navBarColor}}; --bc-bar-w: {{block.navIndWRpx}}rpx; --bc-bar-h: {{block.navIndHRpx}}rpx;"
          >
            <text class="bc-navt">{{navText}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 右栏：内容。背景图铺在底部，标题与分类图浮在它上面（同样是可独立滚动的 scroll-view） -->
      <scroll-view
        class="bc-main {{block.screenMode ? 'screen' : ''}}"
        scroll-y="{{block.screenMode}}"
        style="padding: 0 {{block.padXRpx}}rpx {{block.padBRpx}}rpx;"
      >
        <view
          wx:if="{{block.bgImage}}"
          class="bc-bgimg"
          style="top: {{block.bgTopGapRpx}}rpx; background-image: url({{block.bgImage}});"
        >
          <view
            wx:if="{{block.bgTopLink}}"
            class="bc-bgtop"
            data-link="{{block.bgTopLink}}"
            bindtap="onTapBlock"
          ></view>
        </view>

        <view class="bc-inner">
          <block wx:if="{{block.brands.length}}">
          <block wx:for="{{block.brands[block.activeBrand].panels}}" wx:key="index" wx:for-item="pn" wx:for-index="pi">
            <view style="margin-bottom: {{block.panelGapRpx}}rpx;">
              <view
                wx:if="{{pn.title}}"
                class="bc-ptitle"
                style="font-size: {{block.panelTitleFsRpx}}rpx; font-weight: {{block.panelTitleWeight}}; text-align: {{block.panelTitleAlign}}; padding: 0 {{block.panelTitleGapXRpx}}rpx; margin-bottom: {{block.panelTitleGapYRpx}}rpx; --bc-pfg: {{block.panelTitleFg}};"
                data-link="{{pn.link}}"
                bindtap="onTapBlock"
                hover-class="{{pn.link ? 'hover-lite' : 'none'}}"
                hover-stay-time="80"
              >{{pn.title}}</view>

              <view class="bc-grid" style="margin: 0 -{{block.itemHalfGapRpx}}rpx;">
                <!--
                  每个格子只有「图 + 标题」。三种竖向间距各归各位，别混：
                    · 图 ↔ 标题：标题的 margin-top = itemGapY（有赞 p{margin-top:10px}）；
                    · 网格行 ↔ 行：**第 2 行起的条目**自己在 margin-top 上让 gapRowRpx
                      （有赞实测 5px；挂在条目上而不是格子 padding+容器负 margin，
                       后者会穿透折叠到小组的 13px 下边距，把后面每一块整体上提 5px）；
                    · 导航模式：图与标题左右并排，标题的 margin-top 会被
                      .bc-cell.nav .bc-it 归零，行距只能挂在格子自身的 margin-bottom 上。
                -->
                <view
                  wx:for="{{pn.items}}"
                  wx:key="index"
                  wx:for-item="it"
                  wx:for-index="ii"
                  class="bc-cell {{pn.isNav ? 'nav' : ''}} {{block.effectClass}}"
                  style="width: {{pn.isNav ? 100 : pn.cellW}}%; padding: 0 {{block.itemHalfGapRpx}}rpx; margin-top: {{it.gapTopRpx}}rpx; margin-bottom: {{pn.isNav ? block.itemGapYRpx : 0}}rpx; animation-duration: {{block.effectDurMs}}ms; animation-delay: {{it.delayMs}}ms;"
                  data-link="{{it.hot ? '' : it.link}}"
                  bindtap="onTapBlock"
                  hover-class="{{!it.hot && it.link ? 'hover-lite' : 'none'}}"
                  hover-stay-time="80"
                >
                  <view
                    class="bc-pic {{block.itemShadow ? 'shadow' : ''}} {{pn.isNav ? 'square' : ''}}"
                    style="border-radius: {{block.itemRadiusRpx}}rpx; --bc-ibd: {{block.itemBorderColor}};"
                    data-link="{{it.link}}"
                    data-hot="{{it.hot}}"
                    bindtap="onBrandPicTap"
                  >
                    <image webp="{{true}}"
                      wx:if="{{!it.failed}}"
                      src="{{it.image}}"
                      mode="{{pn.isNav ? 'aspectFill' : 'widthFix'}}"
                      data-blk="{{index}}"
                      data-bi="{{block.activeBrand}}"
                      data-pi="{{pi}}"
                      data-ii="{{ii}}"
                      binderror="onBrandImgError"
                    />
                    <view wx:else class="bc-picph">图片加载失败</view>
                  </view>
                  <view class="bc-txt">
                    <view
                      wx:if="{{it.title}}"
                      class="bc-it"
                      style="margin-top: {{block.itemGapYRpx}}rpx; font-size: {{block.itemFsRpx}}rpx; font-weight: {{block.itemWeight}}; text-align: {{block.itemAlign}}; --bc-ifg: {{block.itemFg}};"
                    >{{it.title}}</view>
                    <view wx:if="{{it.desc}}" class="bc-id" style="text-align: {{block.itemAlign}};">{{it.desc}}</view>
                  </view>
                </view>
              </view>
            </view>
          </block>
          </block>

          <!-- 品牌还没配内容：给运营一句能照着做的提示，而不是空白一片 -->
          <view wx:if="{{!block.brands.length}}" class="bc-empty">该组件还没有品牌，请到装修台「内容设置」里添加</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!--
    ===== 有赞基础/高级组件余下的 37 项（依赖型 + 展示型） =====
    这些组件在有赞里各自依赖一套业务底座（会员 / 营销中台 / 门店 / 直播 / 教育 …），
    自建商城没有对应数据源。按约定「全量复刻，真机标注」：
      · 装修台里可以像有赞一样自由添加、属性面板 1:1 配置；
      · 真机按配置**忠实渲染**（标题 / 主图 / 描述 / 按钮），
      · 并在区块底部原样标注「依赖 XX · 仅占位展示」，不假装可用。
    能真跑的同类组件（商品分组 / 店铺热搜 / 店铺榜单 / 优惠券…）另有专属分支，不走这里。
  -->
  <!-- ===== 商品分组：菜单 + 当前分组的商品（真跑，数据来自商品库分类） ===== -->
  <view wx:elif="{{block.type === 'goods_group'}}" class="c-grp" style="padding: 0 {{block.marginRpx}}rpx;">
    <scroll-view class="cgp-menu {{block.menuTop ? '' : 'left'}}" scroll-x enable-flex>
      <view
        wx:for="{{block.groupTabs}}"
        wx:key="name"
        wx:for-item="g"
        wx:for-index="gi"
        class="cgp-tab {{gi === block.active ? 'on' : ''}}"
        data-b="{{index}}"
        data-gi="{{gi}}"
        bindtap="onTapGroupTab"
      >{{g.name}}</view>
    </scroll-view>
    <view class="cgp-list">
      <view
        wx:for="{{block.groupTabs[block.active].goods}}"
        wx:key="goodsId"
        wx:for-item="g"
        wx:for-index="gIndex"
        class="cgp-cell"
        style="width: {{block.cellW}}%;"
        data-goods="{{g.goodsId}}"
        bindtap="onTapGoods"
        hover-class="hover-lite"
        hover-stay-time="80"
      >
        <view class="cg-card" style="background: {{block.cardBg}};">
          <image webp="{{true}}" wx:if="{{g.image}}" class="cg-img" src="{{g.image}}" mode="aspectFill" />
          <view wx:else class="cg-img cg-img-failed">暂无图片</view>
          <view class="cg-info">
            <view wx:if="{{block.showTitle}}" class="cg-name">{{g.name}}</view>
            <view wx:if="{{block.showPrice}}" class="cg-price">
              <text class="cg-cur">¥</text><text class="cg-num">{{g.priceText}}</text><text wx:if="{{g.originalText}}" class="cg-origin">{{g.originalText}}</text>
            </view>
            <view wx:if="{{block.showBuy}}" class="cg-buy">立即购买</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{block.goodsFailed}}" class="cg-empty">分组里的商品没取到，请检查分组名是否与商品库分类一致</view>
    <view wx:elif="{{!block.groupTabs.length}}" class="cg-empty">还没有配置分组，请到装修台「商品分组」里添加</view>
  </view>

  <!-- ===== 店铺热搜：词表在装修台里配，真机直接用 ===== -->
  <view wx:elif="{{block.type === 'hot_words'}}" class="c-hotw" style="background: {{block.bg || 'transparent'}};">
    <view class="chw-hd">
      <text wx:if="{{block.badgeOn}}" class="chw-badge">热</text>
      <text class="chw-title">{{block.title || '大家都在搜'}}</text>
    </view>
    <view class="chw-list {{block.singleLine ? 'single' : ''}}">
      <view
        wx:for="{{block.words}}"
        wx:key="*this"
        wx:for-item="w"
        class="chw-word"
        style="color: {{block.fg}};"
        data-w="{{w}}"
        bindtap="onSearchTap"
        hover-class="hover-lite"
      >{{w}}</view>
    </view>
    <view wx:if="{{!block.words.length}}" class="cg-empty">还没有配置热词，请到装修台「店铺热搜」里添加</view>
  </view>

  <!--
    ===== 个人中心（「我的」页）专属区块 =====
    对标有赞「个人中心装修」：标题栏 / 个人信息 / 个人资产 / 我的订单 / 必备工具，
    外加个人中心独有的 4 个组件：文本 / 关联链接 / 辅助空白 / 关注公众号。
    依赖型（个人资产、必备工具里的部分项、关注公众号）如实标注「依赖 XX · 仅占位展示」，
    与那 34 个依赖型组件同一口径 —— 不假装可用。
    样式见 pages/mine/mine.wxss 的 .cu- 系列（这些区块目前只出现在「我的」页）。
  -->

  <!-- ===== 标题栏 ===== -->
  <view wx:elif="{{block.type === 'uc_navbar'}}" class="cu-nav" style="background: {{block.bgFinal}};">
    <image webp="{{true}}" wx:if="{{block.hasBgImage}}" class="cu-nav-bg" src="{{block.bgImage}}" mode="aspectFill" />
    <view class="cu-nav-inner">
      <view class="cu-nav-title">{{block.title}}</view>
      <view wx:if="{{block.desc}}" class="cu-nav-desc">{{block.desc}}</view>
    </view>
  </view>

  <!-- ===== 个人信息（外观来自装修数据，昵称/头像由页面回填到 block.user） ===== -->
  <view
    wx:elif="{{block.type === 'uc_profile'}}"
    class="cu-prof"
    style="background: {{block.bgImage ? ('url(' + block.bgImage + ') center / cover no-repeat') : '#FFFFFF'}};"
  >
    <view wx:if="{{block.gradientClass}}" class="cu-prof-gd {{block.gradientClass}}"></view>
    <view class="cu-prof-row" style="justify-content: {{block.justify}};">
      <image webp="{{true}}" wx:if="{{block.user.avatar}}" class="cu-avatar" src="{{block.user.avatar}}" mode="aspectFill" />
      <view wx:else class="cu-avatar cu-avatar-ph"><text class="cu-avatar-t">我</text></view>
      <view class="cu-prof-info">
        <text class="cu-nick" style="color: {{block.nameFg}};">{{block.user.logged ? (block.user.nickname || '微信用户') : '未登录'}}</text>
        <view class="cu-prof-meta">
          <text wx:if="{{block.levelOn && block.user.logged}}" class="cu-level">普通会员</text>
          <view class="cu-code" style="color: {{block.codeFg}};" data-key="memberCode" data-label="会员码" catchtap="onTapToolItem">会员码</view>
        </view>
      </view>
      <view wx:if="{{!block.user.logged}}" class="cu-prof-act" catchtap="onTapUcLogin">{{logging ? '登录中…' : '登录'}}</view>
      <view wx:else class="cu-prof-act ghost" catchtap="onTapUcLogout">退出</view>
    </view>
    <view class="cu-prof-bar {{block.bar}}"></view>
  </view>

  <!-- ===== 个人资产（有底座的项显示真实数值；没底座的项点了说明依赖，不留「点了没反应」） ===== -->
  <view wx:elif="{{block.type === 'uc_stats'}}" class="cu-stats">
    <view class="cu-stats-grid">
      <view
        class="cu-stat"
        wx:for="{{block.items}}"
        wx:key="key"
        data-key="{{item.key}}"
        data-label="{{item.label}}"
        bindtap="onTapUcStat"
        hover-class="hover-lite"
        hover-stay-time="80"
      >
        <image webp="{{true}}"
          wx:if="{{block.items.length === 1 && item.iconFile}}"
          class="cu-stat-ic"
          src="{{item.iconFile}}"
          mode="aspectFit"
        />
        <view class="cu-stat-v">{{item.value}}<text class="cu-stat-u">{{item.unit}}</text></view>
        <view class="cu-stat-l">{{item.label}}</view>
      </view>
    </view>
    <!-- 依赖说明由 blocks.js 的 depLine 产出：正式版不把内部术语念给用户（审查 F22） -->
    <view wx:if="{{block.depLine}}" class="cu-dep">{{block.depLine}}</view>
  </view>

  <!-- ===== 我的订单 ===== -->
  <view wx:elif="{{block.type === 'uc_order'}}" class="cu-order">
    <view class="cu-hd">
      <text class="cu-hd-t">{{block.title}}</text>
      <text wx:if="{{block.showAllOn}}" class="cu-hd-more" data-status="ALL" bindtap="onTapUcOrder">全部订单 ›</text>
    </view>
    <view class="cu-order-grid">
      <view
        class="cu-order-it"
        wx:for="{{block.items}}"
        wx:key="key"
        data-status="{{item.key}}"
        bindtap="onTapUcOrder"
        hover-class="hover-lite"
        hover-stay-time="80"
      >
        <view class="cu-order-ic"><image webp="{{true}}" class="cu-ic" src="{{item.iconFile}}" mode="aspectFit" /></view>
        <text class="cu-order-lb">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 必备工具（条目来自装修数据；「客服聊天」是真按钮，其余按 real 决定是否可跳） ===== -->
  <view wx:elif="{{block.type === 'uc_tools'}}" class="cu-tools {{block.mode}}">
    <view class="cu-tools-grid">
      <block wx:for="{{block.items}}" wx:key="key" wx:for-item="tl">
        <button
          wx:if="{{tl.key === 'customerServiceChat'}}"
          class="cu-tool {{block.iconMode}}"
          style="width: {{block.cellW}}%;"
          open-type="contact"
          hover-class="hover-lite"
          hover-stay-time="80"
        >
          <view class="cu-tool-ic"><image webp="{{true}}" class="cu-ic" src="{{tl.iconFile}}" mode="aspectFit" /></view>
          <text class="cu-tool-lb">{{tl.label}}</text>
        </button>
        <view
          wx:else
          class="cu-tool {{block.iconMode}}"
          style="width: {{block.cellW}}%;"
          data-key="{{tl.key}}"
          data-label="{{tl.label}}"
          bindtap="onTapToolItem"
          hover-class="hover-lite"
          hover-stay-time="80"
        >
          <view class="cu-tool-ic"><image webp="{{true}}" class="cu-ic" src="{{tl.iconFile}}" mode="aspectFit" /></view>
          <text class="cu-tool-lb">{{tl.label}}</text>
        </view>
      </block>
    </view>
    <view wx:if="{{!block.items.length}}" class="cu-empty-chk">所有工具都被关掉了，请到装修台「必备工具」里打开几项</view>
    <view wx:if="{{block.depLine}}" class="cu-dep">{{block.depLine}}</view>
  </view>

  <!-- ===== 文本 ===== -->
  <view wx:elif="{{block.type === 'text'}}" class="cu-text" style="padding: 0 {{block.marginRpx}}rpx;">
    <view class="cu-text-in {{block.sizeClass}}" style="color: {{block.fg}}; background: {{block.bg}};">
      <text class="cu-text-t" style="text-align: {{block.textAlign}};" data-link="{{block.link}}" bindtap="onTapBlock">{{block.text}}</text>
    </view>
    <view wx:if="{{block.splitLine}}" class="cu-split"></view>
  </view>

  <!-- ===== 关联链接 ===== -->
  <view wx:elif="{{block.type === 'link'}}" class="cu-links" style="padding: 0 {{block.marginRpx}}rpx;">
    <view
      class="cu-link"
      wx:for="{{block.items}}"
      wx:key="label"
      data-link="{{item.link}}"
      bindtap="onTapBlock"
      hover-class="hover-lite"
    >
      <text class="cu-link-t">{{item.label}}</text>
      <text class="cu-link-a">›</text>
    </view>
    <view wx:if="{{!block.items.length}}" class="cu-empty-chk">还没有添加关联链接，请到装修台配置</view>
  </view>

  <!-- ===== 辅助空白 ===== -->
  <view wx:elif="{{block.type === 'blank'}}" style="height: {{block.hRpx}}rpx;"></view>

  <!-- ===== 关注公众号（微信原生 official-account；非扫码进入时不展示，属平台行为） ===== -->
  <view wx:elif="{{block.type === 'follow_oa'}}" class="cu-oa" style="padding: 0 {{block.marginRpx}}rpx;">
    <official-account></official-account>
    <view wx:if="{{block.depLine}}" class="cu-dep">{{block.depLine}}</view>
  </view>

  <view wx:elif="{{block.fam}}" class="c-yz" style="padding: 12rpx {{block.marginRpx}}rpx;">
    <view wx:if="{{block.cardTitle}}" class="yz-hd">{{block.cardTitle}}</view>
    <image webp="{{true}}"
      wx:if="{{block.cardImage}}"
      class="yz-pic {{block.round ? 'round' : ''}}"
      src="{{block.cardImage}}"
      mode="widthFix"
      lazy-load
      binderror="onImgError"
    />
    <view wx:if="{{block.cardDesc}}" class="yz-desc">{{block.cardDesc}}</view>
    <view wx:if="{{block.btnText}}" class="yz-btn" hover-class="hover-lite" bindtap="onTapBlock" data-index="{{index}}">{{block.btnText}}</view>
    <view wx:if="{{block.depLine}}" class="yz-dep">{{block.depLine}}</view>
  </view>

  </view>
</block>
