.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.body {
  padding: var(--space-sm) var(--space-base) 0;
}

.item {
  display: flex;
  align-items: center;
  padding: var(--space-base);
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-base);
}

.g-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
}

.g-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: var(--color-bg-muted);
  flex-shrink: 0;
}

.g-img-ph {
  background: var(--color-bg-muted);
}

.g-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.g-name {
  font-size: var(--font-base);
  line-height: 38rpx;
  color: var(--color-text);
}

.g-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.g-price {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-price);
}

.g-sales {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.g-out {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

.g-remove {
  flex: 0 0 auto;
  margin-left: var(--space-sm);
  padding: 0 16rpx;
  height: 52rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  font-size: var(--font-xs);
  line-height: 50rpx;
  white-space: nowrap;
  color: var(--color-text-secondary);
}

.more-tip {
  padding: var(--space-lg) 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  text-align: center;
}

.sk-img {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.sk-lines {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.sk-t1 {
  width: 100%;
  height: 32rpx;
}

.sk-t2 {
  width: 45%;
  height: 28rpx;
  margin-top: 20rpx;
}
