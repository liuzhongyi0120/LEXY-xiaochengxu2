<!-- 新增 / 编辑收货地址（见 edit.js 文件头） -->
<view class="page">
  <view wx:if="{{loading}}" class="loading-tip">
    <view class="spinner"></view>
    <text>加载中…</text>
  </view>

  <block wx:else>
    <view class="form card">
      <view class="f-row">
        <text class="f-k">收货人</text>
        <input
          class="f-i"
          type="text"
          maxlength="20"
          placeholder="请填写收货人姓名"
          placeholder-class="f-ph"
          value="{{form.name}}"
          bindinput="onInputName"
        />
      </view>

      <view class="f-row">
        <text class="f-k">手机号</text>
        <input
          class="f-i"
          type="number"
          maxlength="11"
          placeholder="请填写收货手机号"
          placeholder-class="f-ph"
          value="{{form.phone}}"
          bindinput="onInputPhone"
        />
      </view>

      <picker mode="region" value="{{form.region}}" bindchange="onPickRegion">
        <view class="f-row">
          <text class="f-k">所在地区</text>
          <text class="f-i {{form.regionText ? '' : 'f-i-ph'}}">{{form.regionText || '请选择省 / 市 / 区'}}</text>
          <text class="f-arrow">›</text>
        </view>
      </picker>

      <view class="f-row f-row-top">
        <text class="f-k">详细地址</text>
        <textarea
          class="f-ta"
          maxlength="120"
          placeholder="街道、楼牌号等（例：××路 1 号 101 室）"
          placeholder-class="f-ph"
          value="{{form.detail}}"
          bindinput="onInputDetail"
          auto-height
        />
      </view>
    </view>

    <view class="form card">
      <view class="f-row">
        <text class="f-k">设为默认地址</text>
        <switch class="f-sw" checked="{{form.isDefault}}" color="#C8102E" bindchange="onToggleDefault" />
      </view>
    </view>

    <view class="tip">默认地址会在下单时自动选中；只有一条地址时会自动成为默认。</view>

    <view class="bottom-hold"></view>
    <view class="footer-bar bar">
      <view
        class="btn btn-primary {{saving ? 'btn-disabled' : ''}}"
        bindtap="onSubmit"
        hover-class="hover"
        hover-stay-time="80"
      >{{saving ? '保存中…' : '保存'}}</view>
    </view>
  </block>
</view>
