.page {
  min-height: 100vh;
  background: #f0f0f0;
  padding: 40rpx 24rpx 64rpx;
  box-sizing: border-box;
}

/* ---------- 标题 ---------- */
.head {
  padding: 0 8rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.head-en {
  font-size: 24rpx;
  color: #8a8a8a;
  letter-spacing: 3rpx;
}

.head-title {
  margin-top: 6rpx;
  font-size: 40rpx;
  color: #444444;
  font-weight: 700;
}

/* ---------- 宫格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-2 {
  margin: 0 -9rpx;
}

.grid-2 .cell {
  width: 50%;
  padding: 9rpx;
  box-sizing: border-box;
}

.grid-3 {
  margin: 18rpx -9rpx 0;
}

.grid-3 .cell {
  width: 33.3333%;
  padding: 9rpx;
  box-sizing: border-box;
}

.cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cell-hover {
  opacity: 0.85;
}

.cell-pic {
  width: 100%;
  background: #e6e2dc;
  overflow: hidden;
}

.pic-big {
  height: 456rpx;
}

.pic-small {
  height: 296rpx;
}

.cell-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cell-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #444444;
  font-weight: 600;
  padding-bottom: 16rpx;
}
