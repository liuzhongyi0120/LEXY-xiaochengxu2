<view class="page">
  <!-- 加载骨架：原先加载中是一个纯白空屏，看不出「在加载」还是「真的空」 -->
  <view wx:if="{{loading && !items.length}}" class="list">
    <view class="cart-item" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton sk-check"></view>
      <view class="skeleton sk-thumb"></view>
      <view class="sk-lines">
        <view class="skeleton sk-t1"></view>
        <view class="skeleton sk-t2"></view>
        <view class="skeleton sk-t3"></view>
      </view>
    </view>
  </view>

  <block wx:if="{{items.length}}">
    <view class="list">
      <view class="cart-item" wx:for="{{items}}" wx:key="cartItemId">
        <!-- 勾选 -->
        <view
          class="checkbox {{item.selected ? 'is-checked' : ''}}"
          data-id="{{item.cartItemId}}"
          bindtap="onToggleSelect"
          hover-class="hover"
          hover-stay-time="80"
        ></view>

        <!-- 商品图（加载失败降级为色块 + 名称首字，避免破图） -->
        <image
          wx:if="{{!item.imgError}}"
          class="item-img"
          src="{{item.image}}"
          mode="aspectFill"
          data-id="{{item.goodsId}}"
          data-index="{{index}}"
          bindtap="onTapGoods"
          hover-class="hover"
          hover-stay-time="80"
          binderror="onImgError"
        />
        <view
          wx:else
          class="item-img item-img-fallback"
          data-id="{{item.goodsId}}"
          bindtap="onTapGoods"
          hover-class="hover"
          hover-stay-time="80"
        >
          <text>{{item.fallbackText}}</text>
        </view>

        <!-- 信息 -->
        <view class="item-info">
          <view class="item-head">
            <text class="item-name" data-id="{{item.goodsId}}" bindtap="onTapGoods" hover-class="hover">{{item.name}}</text>
            <text class="item-remove" data-id="{{item.cartItemId}}" bindtap="onRemove" hover-class="hover">删除</text>
          </view>

          <text class="item-spec">{{item.specText}}</text>

          <view class="item-bottom">
            <text class="item-price">¥{{item.priceText}}</text>
            <view class="stepper">
              <view
                class="stepper-btn {{item.quantity <= 1 ? 'is-disabled' : ''}}"
                data-id="{{item.cartItemId}}"
                data-delta="-1"
                bindtap="onQuantityChange"
                hover-class="{{item.quantity <= 1 ? 'none' : 'step-hover'}}"
                hover-stay-time="80"
              >−</view>
              <text class="stepper-num">{{item.quantity}}</text>
              <view
                class="stepper-btn {{item.quantity >= item.stock ? 'is-disabled' : ''}}"
                data-id="{{item.cartItemId}}"
                data-delta="1"
                bindtap="onQuantityChange"
                hover-class="{{item.quantity >= item.stock ? 'none' : 'step-hover'}}"
                hover-stay-time="80"
              >+</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="footer-placeholder"></view>

    <!-- 结算栏 -->
    <view class="footer-bar">
      <view class="checkout-bar">
        <view class="checkout-all" bindtap="onToggleAll" hover-class="hover" hover-stay-time="80">
          <view class="checkbox {{allSelected ? 'is-checked' : ''}}"></view>
          <text class="checkout-all-text">全选</text>
        </view>

        <view class="checkout-total">
          <text class="checkout-label">合计</text>
          <text class="checkout-price">¥{{totalParts.int}}{{totalParts.dec}}</text>
        </view>

        <view
          class="checkout-btn {{selectedCount ? '' : 'is-disabled'}}"
          bindtap="onCheckout"
          hover-class="{{selectedCount ? 'checkout-hover' : 'none'}}"
          hover-stay-time="80"
        >
          结算{{selectedCount ? '(' + selectedCount + ')' : ''}}
        </view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!loading}}"
    text="购物车还是空的"
    buttonText="去逛逛"
    bind:action="onGoShopping"
  />
</view>
