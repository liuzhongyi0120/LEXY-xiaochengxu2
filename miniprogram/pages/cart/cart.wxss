.page {
  min-height: 100vh;
}

/* ---------- 列表 ---------- */
.list {
  padding: 20rpx 24rpx 0;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-head {
  display: flex;
  align-items: flex-start;
}

.item-name {
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  line-height: 38rpx;
  color: #323233;
}

.item-remove {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #969799;
  flex-shrink: 0;
}

.item-spec {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #969799;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.item-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #C8102E;
}

/* ---------- 数量步进器 ---------- */
.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: #323233;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.stepper-btn.is-disabled {
  color: #C8C9CC;
}

.stepper-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #323233;
}

/* ---------- 复选框 ---------- */
.checkbox {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 2rpx solid #C8C9CC;
  border-radius: 50%;
  flex-shrink: 0;
}

.checkbox.is-checked {
  background: #C8102E;
  border-color: #C8102E;
}

.checkbox.is-checked::after {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 7rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(45deg);
}

/* ---------- 结算栏 ---------- */
.footer-placeholder {
  height: 140rpx;
}

.checkout-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.checkout-all {
  display: flex;
  align-items: center;
}

.checkout-all-text {
  font-size: 26rpx;
  color: #323233;
}

.checkout-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-right: 20rpx;
}

.checkout-label {
  font-size: 26rpx;
  color: #323233;
}

.checkout-price {
  margin-left: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #C8102E;
}

.checkout-btn {
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: #C8102E;
  border-radius: 40rpx;
}

.checkout-btn.is-disabled {
  background: #D8D8D8;
}
