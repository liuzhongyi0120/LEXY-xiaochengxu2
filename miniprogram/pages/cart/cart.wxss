.page {
  min-height: 100vh;
}

/* ---------- 列表 ---------- */
.list {
  padding: 20rpx 24rpx 0;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: var(--space-base);
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-base);
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--color-bg-muted);
  flex-shrink: 0;
}

/* 图片加载失败时的降级色块 */
.item-img-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
  text-align: center;
  padding: 8rpx;
  box-sizing: border-box;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-head {
  display: flex;
  align-items: flex-start;
}

.item-name {
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: var(--font-base);
  line-height: 38rpx;
  color: var(--color-text);
}

.item-remove {
  margin-left: var(--space-sm);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.item-spec {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.item-price {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-price);
}

/* ---------- 数量步进器 ---------- */
.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text);
  background: var(--color-bg);
  border-radius: var(--radius-sm);
}

.stepper-btn.is-disabled {
  color: var(--color-text-placeholder);
}

/* 步进器点击态：只在可点时生效（模板里已按 quantity/stock 切换 hover-class） */
.step-hover {
  background: var(--color-bg-hover);
}

.stepper-num {
  min-width: 64rpx;
  text-align: center;
  font-size: var(--font-base);
  color: var(--color-text);
}

/* ---------- 复选框 ---------- */
.checkbox {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border: 2rpx solid var(--color-text-placeholder);
  border-radius: 50%;
  flex-shrink: 0;
}

.checkbox.is-checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox.is-checked::after {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 7rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 3rpx solid var(--color-text-inverse);
  border-bottom: 3rpx solid var(--color-text-inverse);
  transform: rotate(45deg);
}

/* ---------- 结算栏 ---------- */
.footer-placeholder {
  height: 140rpx;
}

.checkout-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.checkout-all {
  display: flex;
  align-items: center;
}

.checkout-all-text {
  font-size: 26rpx;
  color: var(--color-text);
}

.checkout-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-right: 20rpx;
}

.checkout-label {
  font-size: 26rpx;
  color: var(--color-text);
}

.checkout-price {
  margin-left: 8rpx;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-price);
}

.checkout-btn {
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-radius: 40rpx;
}

.checkout-btn.is-disabled {
  background: var(--color-disabled);
}

/* 结算按钮点击态：只在有勾选时生效 */
.checkout-hover {
  opacity: 0.88;
}

/* ---------- 加载骨架（底色/动效走 app.wxss 的 .skeleton） ---------- */
.sk-check {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.sk-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.sk-lines {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.sk-t1 {
  height: 30rpx;
  width: 80%;
  margin-top: 8rpx;
}

.sk-t2 {
  height: 22rpx;
  width: 48%;
  margin-top: 18rpx;
}

.sk-t3 {
  height: 36rpx;
  width: 34%;
  margin-top: 26rpx;
}
