<view class="page" style="background: {{pageBg}};">
  <!-- 左侧品牌导航（无品牌配置时整栏隐藏，把宽度让给空状态） -->
  <scroll-view class="side" scroll-y wx:if="{{!noBrands}}">
    <!-- 导航顶部固定 logo（源页面左栏顶部，669×414 横幅，按宽度自适应高度） -->
    <view class="side-top">
      <image class="side-top-logo" src="{{navLogo}}" mode="widthFix" />
    </view>

    <view
      class="side-item {{activeBrand === index ? 'side-item-active' : ''}}"
      wx:for="{{brands}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="onTapBrand"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 右侧内容：随品牌切换 -->
  <scroll-view
    class="main"
    scroll-y
    scroll-top="{{scrollTop}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="group" wx:for="{{groups}}" wx:key="index" wx:for-item="group" wx:for-index="gindex">
      <view
        class="group-head"
        wx:if="{{group.header && !group.headerFailed}}"
        data-link="{{group.link}}"
        bindtap="onTapBlock"
        hover-class="{{group.link ? 'hover-lite' : 'none'}}"
        hover-stay-time="80"
      >
        <image
          class="group-head-img"
          src="{{group.header}}"
          mode="widthFix"
          lazy-load
          data-gindex="{{gindex}}"
          binderror="onHeaderError"
        />
      </view>

      <view class="prod-grid">
        <view
          class="prod"
          wx:for="{{group.products}}"
          wx:key="id"
          wx:for-item="prod"
          wx:for-index="pindex"
          data-src="{{prod.image}}"
          data-link="{{prod.link}}"
          bindtap="onTapProduct"
          hover-class="prod-hover"
        >
          <view class="prod-pic">
            <image
              wx:if="{{!prod.failed}}"
              class="prod-img"
              src="{{prod.image}}"
              mode="aspectFit"
              lazy-load
              data-gindex="{{gindex}}"
              data-pindex="{{pindex}}"
              binderror="onProdError"
            />
          </view>
          <text class="prod-model">{{prod.model}}</text>
        </view>
      </view>
    </view>

    <!-- 空配置也必须有确定行为：整个产品页没有配任何品牌时，不能是空左栏 + 空右栏 -->
    <empty-state wx:if="{{noBrands}}" text="产品页暂未配置品牌内容，请在装修后台添加" />
    <empty-state wx:elif="{{!groups.length}}" text="该品牌暂无上架产品" />
    <view class="main-bottom"></view>
  </scroll-view>
</view>
