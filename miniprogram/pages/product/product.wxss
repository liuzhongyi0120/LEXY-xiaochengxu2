page {
  height: 100%;
}

.page {
  display: flex;
  height: 100vh;
  background: var(--color-bg-card);
}

/* ---------- 左侧品牌导航 ---------- */
.side {
  width: 196rpx;
  height: 100%;
  flex-shrink: 0;
  background: var(--color-bg);
}

/* 导航顶部固定品牌 logo（源页面左栏顶部，669×414 横幅，按宽度自适应高度） */
.side-top {
  width: 196rpx;
  line-height: 0;
}

.side-top-logo {
  width: 196rpx;
  display: block;
}

.side-item {
  height: 90rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #050505;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* 选中态：源页面为黑底白字 */
.side-item-active {
  background: #000000;
  color: var(--color-text-inverse);
  font-weight: 600;
}

.side-item-active text {
  color: var(--color-text-inverse);
}

/* ---------- 右侧内容 ---------- */
.main {
  flex: 1;
  height: 100%;
  background: var(--color-bg-card);
}

.group {
  padding-bottom: 8rpx;
}

.group-head {
  width: 100%;
}

.group-head-img {
  width: 100%;
  display: block;
  background: var(--color-bg-card);
}

.prod-grid {
  display: flex;
  flex-wrap: wrap;
}

/*
 * 型号卡片。尺寸按源页面取值：
 *   列宽 = 右栏一半（554rpx / 2 = 277rpx），源页面 li 无内边距、图片撑满列宽
 *   图片比例 = 源页面 padding-top 86.15%（实测原图约 1.158），故高度 = 277 / 1.158 ≈ 239rpx
 */
.prod {
  width: 50%;
  box-sizing: border-box;
  padding: 10rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prod-hover {
  opacity: 0.85;
}

.prod-pic {
  width: 100%;
  height: 239rpx;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.prod-img {
  width: 100%;
  height: 100%;
}

.prod-model {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

/* ---------- 空态统一走 components/empty-state ---------- */

.main-bottom {
  height: 40rpx;
}
