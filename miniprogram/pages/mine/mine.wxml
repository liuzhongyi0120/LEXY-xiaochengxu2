<!--
  「我的」（个人中心）—— 装修区块流页面

  对标有赞「个人中心装修」：整页由 replica.MINE_BLOCKS 的区块驱动，
  区块渲染与首页 / 自定义页共用 templates/blocks.wxml 一份实现。

  曾经这里是硬编码页面（头像 + 订单 + 店铺信息 + 常用功能），
  装修台虽然列出「我的」却加不了任何组件 —— 现在改成区块流后两者合一：
  结构与文案在装修台里配，登录 / 退出 / 客服 / 订单跳转等**真实交互仍然保留**。
-->
<view class="page" style="background: {{meta.bg || '#FFFFFF'}};">

  <!-- 装修数据一个区块都没有（运营把区块全删了又还没点「生成代码」时才会出现） -->
  <empty-state
    wx:if="{{!blocks.length}}"
    text="个人中心还没有内容"
    desc="请到装修台「我的」页面添加区块，然后点「生成代码」写回小程序配置"
  />

  <include src="../../templates/blocks.wxml" />

  <view class="version">{{shop.name}} · {{version}}</view>
</view>
