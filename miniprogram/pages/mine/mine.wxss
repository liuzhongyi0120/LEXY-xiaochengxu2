.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ---------- 用户信息 ---------- */
.profile {
  display: flex;
  align-items: center;
  padding: 60rpx 32rpx 80rpx;
  background: var(--color-primary);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-inverse);
}

.profile-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.profile-action {
  padding: 0 32rpx;
  height: 58rpx;
  line-height: 58rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background: var(--color-bg-card);
  border-radius: 29rpx;
}

/* ---------- 通用卡片 ---------- */
.card {
  margin: -40rpx 24rpx 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
}

.tool-card,
.service-card,
.version {
  margin-top: 0;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.card-more {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ---------- 订单入口 ---------- */
.order-tabs {
  display: flex;
}

.order-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.order-tab-hover {
  opacity: 0.7;
}

.order-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--color-primary-light);
  border: 2rpx solid #F5C4B3;
}

.order-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

/* ---------- 工具网格 ---------- */
.tool-grid {
  display: flex;
  flex-wrap: wrap;
}

.tool-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.tool-hover {
  opacity: 0.7;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border-radius: 50%;
}

.tool-icon-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tool-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

/* ---------- 客服 ---------- */
.service-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cell-hover {
  opacity: 0.75;
}

.service-text {
  font-size: 28rpx;
  color: var(--color-text);
}

.service-arrow {
  font-size: 32rpx;
  color: var(--color-text-placeholder);
}

/* ---------- 版本 ---------- */
.version {
  padding: 40rpx 0 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

/* ---------- 资产（本期隐藏：积分/余额/会员卡页面未交付，样式先留着） ---------- */
.asset-card {
  display: flex;
  margin-top: 20rpx;
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.asset-hover {
  background: #fafafa;
}

.asset-num {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
}

.asset-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
}

/* ---------- 头像占位 / 退出按钮 ---------- */
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-ph-text {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.85);
}

.profile-action.ghost {
  color: rgba(255, 255, 255, 0.9);
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

/* ---------- 店铺信息 ---------- */
/* 卡片首屏的 -40rpx 上移只用于第一张卡（与头像区叠压）；后续卡片统一 0，靠上边距自然分隔 */
.shop-card {
  margin-top: 0;
}

.shop-row {
  display: flex;
  align-items: center;
}

.shop-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}

.shop-logo-ph {
  border: 2rpx solid var(--color-border, #eeeeee);
}

.shop-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.shop-slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.shop-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-placeholder);
}

/* 客服按钮：`<button>` 自带边框与内边距，必须清掉才能与旁边的工具项对齐 */
.tool-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}

.tool-btn::after {
  border: 0;
}

