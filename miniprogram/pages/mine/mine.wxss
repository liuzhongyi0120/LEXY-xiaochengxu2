.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ---------- 用户信息 ---------- */
.profile {
  display: flex;
  align-items: center;
  padding: 60rpx 32rpx 80rpx;
  background: #C8102E;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.profile-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.profile-action {
  padding: 0 32rpx;
  height: 58rpx;
  line-height: 58rpx;
  font-size: 26rpx;
  color: #C8102E;
  background: #ffffff;
  border-radius: 29rpx;
}

/* ---------- 通用卡片 ---------- */
.card {
  margin: -40rpx 24rpx 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.tool-card,
.service-card,
.version {
  margin-top: 0;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.card-more {
  font-size: 24rpx;
  color: #969799;
}

/* ---------- 订单入口 ---------- */
.order-tabs {
  display: flex;
}

.order-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.order-tab-hover {
  opacity: 0.7;
}

.order-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #FDECEE;
  border: 2rpx solid #F5C4B3;
}

.order-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #323233;
}

/* ---------- 工具网格 ---------- */
.tool-grid {
  display: flex;
  flex-wrap: wrap;
}

.tool-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.tool-hover {
  opacity: 0.7;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 50%;
}

.tool-icon-text {
  font-size: 28rpx;
  color: #969799;
}

.tool-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #323233;
}

/* ---------- 客服 ---------- */
.service-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cell-hover {
  opacity: 0.75;
}

.service-text {
  font-size: 28rpx;
  color: #323233;
}

.service-arrow {
  font-size: 32rpx;
  color: #C8C9CC;
}

/* ---------- 版本 ---------- */
.version {
  padding: 40rpx 0 0;
  text-align: center;
  font-size: 22rpx;
  color: #C8C9CC;
}

/* ---------- 资产 ---------- */
.asset-card {
  display: flex;
  margin-top: 20rpx;
}

.asset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.asset-hover {
  background: #fafafa;
}

.asset-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #323233;
}

.asset-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
}
