.page {
  display: flex;
  height: 100vh;
  background: var(--color-bg-card);
}

/* ---------- 左侧 ---------- */
.sidebar {
  width: 190rpx;
  height: 100%;
  background: var(--color-bg);
}

.sidebar-scroll {
  height: 100%;
}

.sidebar-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
}

.sidebar-item.is-active {
  background: var(--color-bg-card);
}

.sidebar-bar {
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 40rpx;
  margin-top: -20rpx;
  background: var(--color-primary);
  border-radius: 0 4rpx 4rpx 0;
}

.sidebar-text {
  font-size: 28rpx;
  color: var(--color-text);
}

.sidebar-item.is-active .sidebar-text {
  color: var(--color-primary);
  font-weight: 600;
}

/* ---------- 右侧 ---------- */
.content {
  flex: 1;
  min-width: 0;
  height: 100%;
}

.content-scroll {
  height: 100%;
}

.content-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx 20rpx;
}

.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.content-more {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.sub-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}

.sub-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 28rpx;
}

.sub-hover {
  opacity: 0.7;
}

.sub-thumb {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
  border-radius: 16rpx;
}

.sub-thumb-text {
  font-size: 24rpx;
  color: #B4B2A9;
}

.sub-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

.content-tip {
  padding: 20rpx 24rpx 60rpx;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  text-align: center;
}

/* 空态统一走 components/empty-state */
