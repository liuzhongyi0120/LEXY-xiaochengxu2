<view class="page" style="background: {{meta.bg || '#F5F6F8'}};">
  <!-- 11 种装修区块的渲染见 templates/blocks.wxml（首页与自定义页共用一份，避免两边走样） -->
  <include src="../../templates/blocks.wxml" />

  <!-- 店铺信息（页面级，非区块） -->
  <view class="shop">
    <image class="shop-avatar" src="{{shop.avatar}}" mode="aspectFill" />
    <text class="shop-name">{{shop.name}}</text>
    <text class="shop-slogan">{{shop.slogan}}</text>
  </view>
</view>
