/* ==================== 页面与通用区块 ==================== */
.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
}

.block-wrap {
  display: block;
  box-sizing: border-box;
}

/* 区块内图片 */
.bi {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.biw {
  width: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.bv {
  width: 100%;
  display: block;
}
.round {
  border-radius: 16rpx;
  overflow: hidden;
}

/* 轮播 */
.sw {
  width: 100%;
}
.sw-cell {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}
.num-ind {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  background: rgba(0, 0, 0, .38);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

/* 横向滑动 */
.hscroll {
  width: 100%;
  white-space: nowrap;
}
.hscroll-i {
  width: 560rpx;
  display: inline-block;
  vertical-align: top;
  background: var(--color-bg-muted);
}

/* 双层轮播缩略图 */
.thumb-row {
  white-space: nowrap;
  margin-top: 12rpx;
}
.thumb-i {
  width: 110rpx;
  height: 110rpx;
  display: inline-block;
  margin-right: 10rpx;
  border-radius: 8rpx;
  opacity: .6;
  border: 2rpx solid transparent;
  background: var(--color-bg-muted);
}
.thumb-i.on {
  opacity: 1;
  border-color: var(--color-primary);
}

/* ==================== 标题文本 ==================== */
.c-title {
  box-sizing: border-box;
}
.ct-main {
  line-height: 1.4;
}
.ct-main.s-sm { font-size: 26rpx; }
.ct-main.s-md { font-size: 32rpx; }
.ct-main.s-lg { font-size: 40rpx; }
.ct-main.bold { font-weight: 600; }
.ct-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 辅助分割 ==================== */
.ln {
  border-top-style: solid;
  border-top-color: var(--color-border);
}
.ln.dashed { border-top-style: dashed; }

/* ==================== 公告 ==================== */
.c-notice {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.cn-icon { margin-right: 10rpx; }
.cn-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cn-scroll { flex: 1; height: 64rpx; }

/* ==================== 图文导航 ==================== */
.c-nav {
  display: flex;
  flex-wrap: wrap;
}
.cn-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.cn-i {
  display: block;
}
.cn-t {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

/* ==================== 魔方 ==================== */
.c-cube {
  display: flex;
  flex-wrap: wrap;
}
.cc-cell {
  box-sizing: border-box;
}
.cc-img {
  width: 100%;
  height: 220rpx;
  display: block;
  border-radius: 8rpx;
  background: var(--color-bg-muted);
}

/* ==================== 热区切图 ==================== */
.hs-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.hs-area {
  position: absolute;
  z-index: 2;
}

/* ==================== 店铺信息 ==================== */
.c-shop {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.cs-av {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--color-bg-muted);
}
.cs-txt {
  display: flex;
  flex-direction: column;
}
.cs-n {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.cs-s {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 商品 ==================== */
.c-goods {
  box-sizing: border-box;
}
.cg-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  padding: 24rpx 0 12rpx;
}
.cg-grid {
  display: flex;
  flex-wrap: wrap;
}
.cg-cell {
  box-sizing: border-box;
  padding: 8rpx;
}
.cg-card {
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .05);
}
.cg-img {
  width: 100%;
  height: 320rpx;
  display: block;
  background: var(--color-bg-muted);
}
/* 商品图加载失败时的降级色块 */
.cg-img-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}
.cg-info {
  padding: 12rpx;
}
.cg-name {
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cg-price {
  margin-top: 8rpx;
  color: var(--color-price);
}
.cg-cur { font-size: 22rpx; }
.cg-num { font-size: 32rpx; font-weight: 600; }
.cg-buy {
  margin-top: 10rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-radius: 26rpx;
}
.cg-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

/* ==================== 页面级店铺信息（原有） ==================== */
.shop {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.shop-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-muted);
}
.shop-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.shop-slogan {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
