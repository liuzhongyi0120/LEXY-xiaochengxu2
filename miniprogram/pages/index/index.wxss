/* ==================== 页面与通用区块 ==================== */
.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
}

.block-wrap {
  display: block;
  box-sizing: border-box;
}

/* 区块内图片 */
.bi {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.biw {
  width: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.bv {
  width: 100%;
  display: block;
}
.round {
  border-radius: 16rpx;
  overflow: hidden;
}

/* 轮播 */
.sw {
  width: 100%;
}
.sw-cell {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}
.num-ind {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  background: rgba(0, 0, 0, .38);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

/* 横向滑动 */
.hscroll {
  width: 100%;
  white-space: nowrap;
}
.hscroll-i {
  width: 560rpx;
  display: inline-block;
  vertical-align: top;
  background: var(--color-bg-muted);
}

/* 双层轮播缩略图 */
.thumb-row {
  white-space: nowrap;
  margin-top: 12rpx;
}
.thumb-i {
  width: 110rpx;
  height: 110rpx;
  display: inline-block;
  margin-right: 10rpx;
  border-radius: 8rpx;
  opacity: .6;
  border: 2rpx solid transparent;
  background: var(--color-bg-muted);
}
.thumb-i.on {
  opacity: 1;
  border-color: var(--color-primary);
}

/* ==================== 标题文本 ==================== */
.c-title {
  box-sizing: border-box;
}
.ct-main {
  line-height: 1.4;
}
.ct-main.s-sm { font-size: 26rpx; }
.ct-main.s-md { font-size: 32rpx; }
.ct-main.s-lg { font-size: 40rpx; }
.ct-main.bold { font-weight: 600; }
.ct-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 辅助分割 ==================== */
.ln {
  border-top-style: solid;
  border-top-color: var(--color-border);
}
.ln.dashed { border-top-style: dashed; }

/* ==================== 公告 ==================== */
.c-notice {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.cn-icon { margin-right: 10rpx; }
.cn-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cn-scroll { flex: 1; height: 64rpx; }

/* ==================== 图文导航 ==================== */
.c-nav {
  display: flex;
  flex-wrap: wrap;
}
.cn-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.cn-i {
  display: block;
}
.cn-t {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

/* ==================== 魔方 ==================== */
.c-cube {
  display: flex;
  flex-wrap: wrap;
}
.cc-cell {
  box-sizing: border-box;
}
.cc-img {
  width: 100%;
  height: 220rpx;
  display: block;
  border-radius: 8rpx;
  background: var(--color-bg-muted);
}

/* ==================== 热区切图 ==================== */
.hs-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.hs-area {
  position: absolute;
  z-index: 2;
}

/* ==================== 店铺信息 ==================== */
.c-shop {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.cs-av {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--color-bg-muted);
}
.cs-txt {
  display: flex;
  flex-direction: column;
}
.cs-n {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.cs-s {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 商品 ==================== */
.c-goods {
  box-sizing: border-box;
}
.cg-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  padding: 24rpx 0 12rpx;
}
.cg-grid {
  display: flex;
  flex-wrap: wrap;
}
.cg-cell {
  box-sizing: border-box;
  padding: 8rpx;
}
.cg-card {
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .05);
}
.cg-img {
  width: 100%;
  height: 320rpx;
  display: block;
  background: var(--color-bg-muted);
}
/* 商品图加载失败时的降级色块 */
.cg-img-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}
.cg-info {
  padding: 12rpx;
}
.cg-name {
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cg-price {
  margin-top: 8rpx;
  color: var(--color-price);
}
.cg-cur { font-size: 22rpx; }
.cg-num { font-size: 32rpx; font-weight: 600; }
.cg-buy {
  margin-top: 10rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-radius: 26rpx;
}
.cg-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

/* ==================== 页面级店铺信息（原有） ==================== */
.shop {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.shop-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-muted);
}
.shop-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.shop-slogan {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 区块锚点（电梯导航定位用） ==================== */
.blk {
  display: block;
}

/* ==================== 富文本 ==================== */
.c-rich {
  display: block;
}
.cr-body {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text);
  line-height: 1.7;
  word-break: break-all;
}

/* ==================== 商品搜索 ==================== */
.c-search {
  display: block;
}
.cs-box {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 6rpx;
  overflow: hidden;
}
.cs-box.round {
  border-radius: 999rpx;
}
.cs-ico {
  font-size: 26rpx;
  margin-right: 10rpx;
}
.cs-ph {
  flex: 1;
  font-size: var(--font-sm);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cs-scan {
  flex: 0 0 auto;
  margin-left: 10rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* ==================== 电梯导航 ==================== */
.c-elev {
  display: block;
}
.ce-scroll {
  white-space: nowrap;
  width: 100%;
}
.ce-tag {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  font-size: var(--font-sm);
  margin-right: 8rpx;
}
/* 标签风格：背景模式 / 圆框 / 方框 / 下划线（与有赞四选一一致） */
.ce-tag.bg.on {
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}
.ce-tag.round {
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}
.ce-tag.round.on {
  border-color: var(--color-primary);
}
.ce-tag.square {
  border: 1rpx solid var(--color-border);
  border-radius: 6rpx;
}
.ce-tag.square.on {
  border-color: var(--color-primary);
}
.ce-tag.underline {
  border-bottom: 4rpx solid transparent;
}
.ce-tag.underline.on {
  border-bottom-color: var(--color-primary);
}
.ce-drop {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
}
.ce-dropitem {
  font-size: var(--font-sm);
  padding: 8rpx 20rpx;
}

/* ==================== 进入店铺 / 在线客服（按钮行） ==================== */
.c-btnrow {
  display: flex;
  align-items: center;
}
.cbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  height: 72rpx;
  padding: 0 40rpx;
  font-size: var(--font-base);
  border-radius: 6rpx;
  line-height: 1;
  margin: 0;
}
.cbtn::after {
  border: none;
}
.cbtn.round {
  border-radius: 999rpx;
}

/* ==================== 语音 ==================== */
.c-audio {
  display: flex;
  align-items: center;
}
.c-audio.right {
  flex-direction: row-reverse;
}
.ca-av {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg-muted);
  flex: none;
}
.ca-bubble {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 20rpx;
  padding: 18rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
}
.ca-text {
  font-size: var(--font-sm);
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ca-dur {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}
.ca-ico {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}

/* ==================== 内容卡片 ==================== */
.c-ccard {
  display: block;
}
.cc-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  padding: 8rpx 4rpx 16rpx;
}
.cc-grid {
  display: flex;
  flex-wrap: wrap;
}
.cc-cell {
  box-sizing: border-box;
  padding: 8rpx;
}
.cc-card {
  overflow: hidden;
  background: var(--color-bg-card);
}
.cc-card.shadow {
  border-radius: var(--radius-base);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .06);
}
.cc-card.white {
  border-radius: 0;
}
.cc-card.plain {
  background: transparent;
}
.cc-pic {
  position: relative;
  width: 100%;
  height: 0;
  background: var(--color-bg-muted);
  overflow: hidden;
}
.cc-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.cc-body {
  padding: 16rpx;
}
.cc-t {
  font-size: var(--font-base);
  color: var(--color-text);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cc-d {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cc-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}
.cc-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}
.cc-m {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-right: 16rpx;
}
.cc-more {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  padding: 20rpx 0 4rpx;
}

/* ==================== 购买按钮（固定吸底） ==================== */
.cb-spacer {
  width: 100%;
}
.c-buybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
}
.cb-row {
  display: flex;
  align-items: center;
  height: 100%;
  box-sizing: border-box;
}
.cb-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 300rpx;
  padding: 0 60rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}
