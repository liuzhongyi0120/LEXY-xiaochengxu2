/* ==================== 页面与通用区块 ==================== */
.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
}

.block-wrap {
  display: block;
  box-sizing: border-box;
}

/* 区块内图片 */
.bi {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.biw {
  width: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.bv {
  width: 100%;
  display: block;
}
.round {
  border-radius: 16rpx;
  overflow: hidden;
}

/* 轮播 */
.sw {
  width: 100%;
}
.sw-cell {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}
.num-ind {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  background: rgba(0, 0, 0, .38);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

/* 横向滑动 */
.hscroll {
  width: 100%;
  white-space: nowrap;
}
.hscroll-i {
  width: 560rpx;
  display: inline-block;
  vertical-align: top;
  background: var(--color-bg-muted);
}

/* 双层轮播缩略图 */
.thumb-row {
  white-space: nowrap;
  margin-top: 12rpx;
}
.thumb-i {
  width: 110rpx;
  height: 110rpx;
  display: inline-block;
  margin-right: 10rpx;
  border-radius: 8rpx;
  opacity: .6;
  border: 2rpx solid transparent;
  background: var(--color-bg-muted);
}
.thumb-i.on {
  opacity: 1;
  border-color: var(--color-primary);
}

/* ==================== 标题文本 ==================== */
.c-title {
  box-sizing: border-box;
}
.ct-main {
  line-height: 1.4;
}
.ct-main.s-sm { font-size: 26rpx; }
.ct-main.s-md { font-size: 32rpx; }
.ct-main.s-lg { font-size: 40rpx; }
/* 有赞「标题文本」的加粗是 font-weight: bold（= 700），不是 600 */
.ct-main.bold { font-weight: 700; }
.ct-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 辅助分割 ==================== */
.ln {
  border-top-style: solid;
  border-top-color: var(--color-border);
}
.ln.dashed { border-top-style: dashed; }

/* ==================== 公告 ==================== */
.c-notice {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.cn-icon { margin-right: 10rpx; }
.cn-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cn-scroll { flex: 1; height: 64rpx; }

/* ==================== 图文导航 ==================== */
.c-nav {
  display: flex;
  flex-wrap: wrap;
}
.cn-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.cn-i {
  display: block;
}
.cn-t {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

/* ==================== 魔方 ==================== */
.c-cube {
  display: flex;
  flex-wrap: wrap;
}
.cc-cell {
  box-sizing: border-box;
}
.cc-img {
  width: 100%;
  height: 220rpx;
  display: block;
  border-radius: 8rpx;
  background: var(--color-bg-muted);
}

/* ==================== 热区切图 ==================== */
.hs-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.hs-area {
  position: absolute;
  z-index: 2;
}

/* ==================== 店铺信息 ==================== */
.c-shop {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.cs-av {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--color-bg-muted);
}
.cs-txt {
  display: flex;
  flex-direction: column;
}
.cs-n {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.cs-s {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 商品 ==================== */
.c-goods {
  box-sizing: border-box;
}
.cg-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  padding: 24rpx 0 12rpx;
}
.cg-grid {
  display: flex;
  flex-wrap: wrap;
}
.cg-cell {
  box-sizing: border-box;
  padding: 8rpx;
}
.cg-card {
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .05);
}
.cg-img {
  width: 100%;
  height: 320rpx;
  display: block;
  background: var(--color-bg-muted);
}
/* 商品图加载失败时的降级色块 */
.cg-img-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}
.cg-info {
  padding: 12rpx;
}
.cg-name {
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cg-price {
  margin-top: 8rpx;
  color: var(--color-price);
}
.cg-cur { font-size: 22rpx; }
.cg-num { font-size: 32rpx; font-weight: 600; }
.cg-buy {
  margin-top: 10rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-radius: 26rpx;
}
.cg-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

/* ==================== 页面级店铺信息（原有） ==================== */
.shop {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.shop-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-muted);
}
.shop-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.shop-slogan {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 区块锚点（电梯导航定位用） ==================== */
.blk {
  display: block;
}

/* ==================== 富文本 ==================== */
.c-rich {
  /*
   * 有赞「富文本」模块的口径（2026-10-12 在 375 宽真机实测 .cap-richtext）：
   *   padding: 10px 10px 0（左右由模板按「页面边距」内联下发）、font-size: 16px、line-height: 24px。
   *
   * ⚠️ 上内边距 10px 不是装饰，缺了它会**连带改变整块占位**：容器 padding-top 为 0 时，
   *    首个 <p> 的 margin-top 会穿透容器继续往外折（margin 折叠），
   *    结果是「整块被往下顶 5px、总高少 10px」—— 复刻资讯 8 页时页面整体因此比有赞矮 5px，
   *    而其它每一块都量得准，非常难查。改这里请一起跑 .tooling/_yz3-compare.mjs。
   */
  display: block;
  font-size: 32rpx;
  /*
   * 行高必须是**比率 1.5**，不能写成固定长度（如 48rpx）——
   * line-height 是比率时逐元素**重算**（24px 字号 → 36px、14px → 21px），
   * 写成固定长度则原样继承（都变 24px）。
   * 有赞 `.cap-richtext` 量的就是比率：容器 16px 字号算出来 24px，同一个 <p> 里的
   * 24px 与 14px 两个 span 分别是 36px 与 21px。写错的表现是「富文本里混排大小字时整块偏矮」
   * ——「售后服务」页因此矮 9px，后面所有区块跟着上移 9px。
   */
  line-height: 1.5;
  /* 收住**末段**的下外边距（有赞 .cap-richtext 同样收住了，量出来容器高 75 而内容只到 70）。
     不收的话末段的 5px margin 会穿透容器落到容器外 —— 排版位置一样，
     但容器盒子会矮 5px，「富文本块多高」这个数就对不上，以后排查会被这 5px 牵着走。 */
  overflow: hidden;
}
.cr-body {
  display: block;
  color: var(--color-text);
  word-break: break-all;
  /* 字号/行高一律从 .c-rich 继承（有赞那边也是容器给、内容继承），
     这里再写一份就会盖掉容器口径，出现「容器 16px、内容 14px」。 */
}

/* ==================== 商品搜索 ==================== */
.c-search {
  display: block;
}
.cs-box {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 6rpx;
  overflow: hidden;
}
.cs-box.round {
  border-radius: 999rpx;
}
.cs-ico {
  font-size: 26rpx;
  margin-right: 10rpx;
}
.cs-ph {
  flex: 1;
  font-size: var(--font-sm);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cs-scan {
  flex: 0 0 auto;
  margin-left: 10rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* ==================== 电梯导航 ==================== */
.c-elev {
  display: block;
}
/*
 * 「全店风格」的纯文字页签条（有赞实测：整条 44px，每项 flex:1 均分，文字 14px 居中，
 * 选中项加粗 + 换成选中色）。有赞那条 `.van-tabs__line` 指示线在这里是**白色**，
 * 白底上等于不可见，所以不画 —— 状态只靠文字颜色/字重区分。
 */
.ce-plain {
  display: flex;
  /* stretch 而不是 center：有赞的页签项是**整条高**（实测 44px，flex 项在 flex-start 的容器里
     默认 stretch），文字在项内自己居中。用 center 的话「项」只有一行高（16.8px），
     虽然文字看起来位置一样，但**可点区域小了一大半**，真机上点上下边缘点不中。 */
  align-items: stretch;
  width: 100%;
}
.ce-plainitem {
  flex: 1 1 0%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 有赞实测 line-height: 20px（14px 字号） */
  line-height: 20px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ce-scroll {
  white-space: nowrap;
  width: 100%;
}
.ce-tag {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  font-size: var(--font-sm);
  margin-right: 8rpx;
}
/* 标签风格：背景模式 / 圆框 / 方框 / 下划线（与有赞四选一一致） */
.ce-tag.bg.on {
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}
.ce-tag.round {
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}
.ce-tag.round.on {
  border-color: var(--color-primary);
}
.ce-tag.square {
  border: 1rpx solid var(--color-border);
  border-radius: 6rpx;
}
.ce-tag.square.on {
  border-color: var(--color-primary);
}
.ce-tag.underline {
  border-bottom: 4rpx solid transparent;
}
.ce-tag.underline.on {
  border-bottom-color: var(--color-primary);
}
.ce-drop {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
}
.ce-dropitem {
  font-size: var(--font-sm);
  padding: 8rpx 20rpx;
}

/* ==================== 进入店铺 / 在线客服（按钮行） ==================== */
.c-btnrow {
  display: flex;
  align-items: center;
}
.cbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  height: 72rpx;
  padding: 0 40rpx;
  font-size: var(--font-base);
  border-radius: 6rpx;
  line-height: 1;
  margin: 0;
}
.cbtn::after {
  border: none;
}
.cbtn.round {
  border-radius: 999rpx;
}

/* ==================== 语音 ==================== */
.c-audio {
  display: flex;
  align-items: center;
}
.c-audio.right {
  flex-direction: row-reverse;
}
.ca-av {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg-muted);
  flex: none;
}
.ca-bubble {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 20rpx;
  padding: 18rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
}
.ca-text {
  font-size: var(--font-sm);
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ca-dur {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}
.ca-ico {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}

/* ==================== 内容卡片 ==================== */
.c-ccard {
  display: block;
}
.cc-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  padding: 8rpx 4rpx 16rpx;
}
.cc-grid {
  display: flex;
  flex-wrap: wrap;
}
.cc-cell {
  box-sizing: border-box;
  padding: 8rpx;
}
.cc-card {
  overflow: hidden;
  background: var(--color-bg-card);
}
.cc-card.shadow {
  border-radius: var(--radius-base);
  /* 2026-10-12 对齐有赞「内容卡片」的 .cardShadow 实测值 box-shadow: 0 2px 4px rgba(0,0,0,.08)
     （原来是我们自己定的 0 2px 8px rgba(0,0,0,.06)：模糊半径大 4px、又淡一点）。 */
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, .08);
}
.cc-card.white {
  border-radius: 0;
}
.cc-card.plain {
  background: transparent;
}
.cc-pic {
  position: relative;
  width: 100%;
  height: 0;
  background: var(--color-bg-muted);
  overflow: hidden;
}
.cc-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
/* 「图片比例 · 自适应」：不撑比例盒，按原图比例铺满整宽（有赞 widthFix 同款） */
.cc-img-auto {
  display: block;
  width: 100%;
}
.cc-body {
  padding: 16rpx;
}
.cc-t {
  font-size: var(--font-base);
  color: var(--color-text);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cc-d {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cc-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}
.cc-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}
.cc-m {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-right: 16rpx;
}
.cc-more {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  padding: 20rpx 0 4rpx;
}

/* ==================== 混合排列（对标有赞三方扩展「混合排列A」） ====================
 * 取值来源：2026-10-12 在真机视口（375 宽）下量有赞线上页得到，
 * 半像素值（4.5px / 7.5px）由 JS 换算成 9rpx / 15rpx，所以这里只放与取值无关的骨架样式。
 * 卡片底色 / 圆角 / 图片比例 / 字号 全部走内联 style（它们都是可配字段）。
 */
.c-mg {
  display: block;
  box-sizing: border-box;
}
.mg-head {
  box-sizing: border-box;
  /*
   * 「标题上间距」用 padding-top 而不是 margin-top，是**踩过一次坑**的：
   * 有赞那边标题块的父层是 flex 容器，margin-top 45px 老老实实留在内部（模块高 747.9）；
   * 我们这里是普通 block，`.mg-head` 的 margin-top 会**穿透父元素**（外边距折叠），
   * 结果模块顶部的灰底少 45px、整块内容上移——并排一量 Δy 就是 45。
   * padding-top 不会折叠，位置与有赞逐像素一致，且语义（模块内部的上间距）更准。
   */
  padding-left: 30rpx;   /* = 有赞 .panel-title 的 padding-left: 15px */
}
.mg-sub {
  line-height: 1;        /* 有赞 line-height: 16px = font-size，标题块高度 16+28+6 */
  margin-bottom: 12rpx;
}
.mg-title {
  line-height: 1.4;      /* 有赞 line-height: 28px（字号 20） */
}
.mg-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
}
.mg-cell {
  box-sizing: border-box;
}
.mg-card {
  overflow: hidden;
  /* 入场：淡入 + 上浮 20px，同一排内依次延迟 0 / 0.16 / 0.32 秒（delay 由 JS 给）
     both 让延迟期间保持起始态，否则卡片会先完整显示再跳回透明 */
  animation: mg-in .8s ease-out both;
}
.mg-card.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .08);
}
.mg-card.outline {
  border: 1rpx solid var(--color-border);
}
.mg-pic {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  background: var(--color-bg-muted);
}
.mg-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.mg-body {
  /*
   * flex 列：**故意用 flex 而不是 block**，为了与有赞 `.item_info`（display:flex）同口径 ——
   * block 容器里 `.mg-t` 的 margin-top 会折叠穿透，`.mg-body` 的盒子会从 327.5/26 变成 332.5/21，
   * 名称自身的坐标两份都对，但量盒子对账时对不上；flex 容器不会与子元素折叠，盒子与有赞逐像素一致。
   */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.mg-t {
  margin-top: 10rpx;     /* = 有赞 .item_title 的 margin-top: 5px */
  line-height: 1.5;      /* 有赞 line-height: 21px（字号 14） */
}
.mg-t.one {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mg-t.two {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
@keyframes mg-in {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 选项卡分类（对标有赞三方扩展「选项卡Z4」） ====================
 * 取值来源：2026-10-12 真机 375 视口量盒（.tooling/_yz3-measure.mjs）+ 扩展自身的 CSS 规则
 * （.tooling/_yz3-css.js，从线上 document.styleSheets 抄录）。
 * 这里只放与取值无关的骨架：底色 / 圆角 / 间距 / 字号 全部走内联 style（它们都是可配字段）。
 *
 * 选项卡条口径（与有赞扩展逐项对齐）：
 *   - 整条高 76rpx（= 有赞 38px）；每项 flex:1 均分；
 *   - 文字块高 68rpx、行高 68rpx、下留 8rpx
 *     （= 有赞 .nav_text 的 height/line-height 34px + margin-bottom 4px）；
 *   - 选中项加粗（有赞 .nav_text.curent 的 font-weight:bold），**但颜色不变**
 *     —— 实测 8 个页面里「导航文字色」与「导航选中色」都是 #444444，靠加粗区分选中；
 *   - 短横线：宽固定 80rpx（= 有赞 40px）、高 4rpx（= 2px）、贴在选项卡条底边、
 *     水平居中于文字 → 用「绝对定位 + left:50% + margin-left:-40rpx」还原
 *     （有赞那两条线里 `.van-tabs__line` 被 display:none 关掉了，实线是每项自带的 text_line）。
 */
.c-tc {
  display: block;
  box-sizing: border-box;
}
.tc-tabs {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
}
.tc-tab {
  position: relative;
  flex: 1 1 0%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.tc-tab-txt {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  margin-bottom: 8rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tc-tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 80rpx;
  height: 4rpx;
  margin-left: -40rpx;
}
.tc-body {
  display: block;
}
.tc-grid {
  /*
   * ⚠️ 这一层**不能** overflow: hidden（曾经是 hidden，2026-10-12 用探针纠正）。
   *
   * 旧注释的理由是「与有赞 `.con` 完全同构，负外边距溢出的那几像素在有赞那边也被这层裁掉」——
   * 实测是错的：`_yz3-bg-probe.mjs` 把有赞 `.con` 的祖先链摊开后，
   *   `.con`        x=10 w=355  **overflow: visible**
   *   `.con_iner`   x=4  w=367  overflow: visible
   *   `van-tabs__content` x=0 w=375 overflow: hidden（够宽，裁不到卡片投影）
   * 而我们的 `.tc-grid` 是 x=10 w=355 + hidden —— 裁剪盒**正好等于卡片盒**，
   * 于是 `.tc-card.shadow` 的 `0 4rpx 8rpx` 被齐着卡片边裁掉，**卡片投影一点都画不出来**
   * （计算样式里 box-shadow 明明一致，像素上两边差 6 级：有赞 241,242,244 / 我们 247,248,250）。
   *
   * 去掉 overflow 后：`.tc-out`/`.tc-row` 仍在 4..371（负外边距照旧，盒子逐项不变），
   * 只是不再被裁 —— 与有赞同构。外层 `.c-tc`/`.tc-body` 都是 0..375，溢不出手机屏。
   */
  box-sizing: border-box;
}
.tc-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
}
.tc-out {
  /* 与有赞 `.list_out { flex-shrink: 0 }` 一致：宽度类（one/two/three → 100/50/33.33%）
     由 JS 算成 block.cellW 后内联下发，半行留白行为随之自然一致。 */
  flex-shrink: 0;
  box-sizing: border-box;
}
.tc-card {
  /* 有赞 `.list` 是 flex 列（`.f_dis.f_col`）—— 标题的 margin 不会折叠穿透，
     盒子量出来才与有赞逐像素一致（与「混合排列」的 .mg-body 同一个坑同一个口径）。 */
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.tc-card.shadow {
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, .06);
}
.tc-card.outline {
  border: 1rpx solid rgba(50, 50, 51, .1);
}
.tc-pic {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
}
.tc-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.tc-img-auto {
  display: block;
  width: 100%;
}
.tc-vpic {
  width: 100%;
  height: 0;
  padding-top: 56.25%;
  position: relative;
}
.tc-video {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.tc-title {
  box-sizing: border-box;
  word-break: break-all;
  /*
   * 行高 1.5 —— 有赞 `.item_title` 的实测值：14px 字号 → 21px、11px → 16.5px、14px → 21px，
   * 三个页面都是「字号 × 1.5」，是**比率**不是固定值。
   * 不写就按 `normal` 算（≈1.36），两行标题矮 3~4px，卡片高度、整页高度跟着一起错
   * （「新闻大事」整页因此矮 30px、「用户分享」矮 15px）。
   */
  line-height: 1.5;
}
.tc-title.one {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tc-title.two {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.tc-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #b8bec8;
}

/* ==================== 购买按钮（固定吸底） ==================== */
.cb-spacer {
  width: 100%;
}
.c-buybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
}
.cb-row {
  display: flex;
  align-items: center;
  height: 100%;
  box-sizing: border-box;
}
.cb-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 300rpx;
  padding: 0 60rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}

/* ==================== 品牌分类（对标有赞「高级组件 · 品牌分类E」） ==================== */
/* 左栏品牌导航 + 右栏图文；5 种标题风格的差异全部靠 class + CSS 变量表达，
   具体取值由 utils/blocks.js 算好放进 inline style（模板里不做任何算术）。 */
.c-bcat {
  position: relative;
  overflow: hidden;
}
.bc-wrap {
  display: flex;
  align-items: stretch;
}
.bc-navcol {
  flex: 0 0 auto;
  overflow: hidden;
}
/*
 * 高度模式 = 占满一屏：左右两栏取一屏高，各自内部滚动（有赞线上品牌分类页的形态）。
 *
 * ⚠️ 必须写在 WXSS 里，**不能**写成模板的 inline style ——
 *    inline 的 `100vh` 不经过 mp-wxss 的 vh→px 换算（那一步只处理 .wxss 文件），
 *    预览页里会直接取**浏览器窗口**高度，整个盒子高出一截、滚动条位置也不对。
 *    真机上 `100vh` = 页面可视区高度，这里写的就是要换算的那一个。
 */
.bc-navcol.screen,
.bc-main.screen {
  height: 100vh;
}

/* 左栏顶部：Logo / 搜索框
   实测有赞的 Logo 就是**整栏宽**的一条（98 × 60.34），没有内边距 ——
   曾经写成 padding: 12rpx（6px），图会缩到 85.5 宽，与真机差 6px。 */
.bc-logo {
  padding: 0;
}
.bc-logo image {
  width: 100%;
  display: block;
}
.bc-search {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(0, 0, 0, .06);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 导航项：外层负责间距 / 分隔线，内层负责色块与文字 */
.bc-nav {
  position: relative;
  box-sizing: border-box;
}
.bc-nav.is-d {
  border-bottom: 1rpx solid var(--bc-line, #DDDDDD);
}
.bc-navi {
  position: relative;
  display: flex;
  align-items: center;
  /* 20rpx = 10px：实测有赞「品牌分类E」的标题容器 padding 为 `0 10px`，
     文字因此从栏内左边缘缩进 10px。曾经写成 12rpx（6px），差 4px。 */
  padding: 0 20rpx;
  overflow: hidden;
  background: var(--bc-bg, transparent);
  color: var(--bc-fg, #050505);
  font-weight: var(--bc-w, 300);
}
.bc-navi.on {
  background: var(--bc-bg-on, #000000);
  color: var(--bc-fg-on, #FFFFFF);
  font-weight: var(--bc-w-on, 450);
}
/* 风格 C：跟随选中项的左侧竖条（高度 / 宽度 / 颜色都可配） */
.bc-navi.is-c.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: var(--bc-bar-w, 2rpx);
  height: var(--bc-bar-h, 20rpx);
  margin-top: -1rpx;
  transform: translateY(-50%);
  background: var(--bc-bar, #000000);
}
.bc-navt {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.25;
}

/* 右栏 */
.bc-main {
  position: relative;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}
.bc-bgimg {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: top center;
  background-repeat: no-repeat;
}
.bc-bgtop {
  height: 56rpx;
}
.bc-inner {
  position: relative;
}
.bc-ptitle {
  color: var(--bc-pfg, var(--color-text));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bc-grid {
  display: flex;
  flex-wrap: wrap;
}
.bc-cell {
  box-sizing: border-box;
}
/*
 * 网格行间距 = 5px（有赞实测：第 2 行起的条目额外有 `margin-top:5px`），
 * 由模板按「条目所在行号」逐条挂在条目自身的 `margin-top` 上 —— 见 blocks.wxml。
 * ⚠️ 不要用「格子 padding-bottom + 容器负 margin-bottom」来做行距：
 *    容器的负 margin-bottom 会**穿透折叠**到小组容器的 13px 下边距上，
 *    正负相加 = 13 + (-5) = 8px → 后面每一块整体上移 5px，
 *    现象是「越往下偏得越多」，量出来的差异带会比不改还多。
 *    也**不要**用 flex 的 row-gap：本项目 WXSS 从未用过 `gap`，而 flex `gap`
 *    要 iOS 14.1+ 的 WebKit 才支持，老系统上是**静默失效**（不是降级）。
 */

/* 分类图：网格模式按原图比例撑高（widthFix），导航模式固定方形 */
.bc-pic {
  position: relative;
  overflow: hidden;
}
/*
 * ⚠️ 网格模式的图盒**不铺底色**：有赞的图盒是透明的（computed `rgba(0,0,0,0)`）。
 * 型号图里有相当一部分是**带透明通道**的（如 H5 的 260×224 PNG，92% 像素 alpha=0），
 * 铺一层 --color-bg-muted 就会在真机上透出一块灰底，而有赞那里是白的 ——
 * 一个像素级可见的差异。兜底底色只留给导航模式的小方图（见 .bc-pic.square）。
 */
.bc-pic.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .16);
}
.bc-pic image {
  width: 100%;
  display: block;
}
.bc-pic.square {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid var(--bc-ibd, transparent);
  background: var(--color-bg-muted);
}
.bc-pic.square image {
  height: 100%;
}
.bc-picph {
  padding: 24rpx 0;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.bc-txt {
  min-width: 0;
}
/* 图与标题之间的间距由模板的 inline `margin-top: itemGapY` 提供
   （实测有赞为 10px —— p{margin-top:10px}），这里不再写死值。
   `.bc-cell` 上**不能**再挂 margin-bottom：那会让每行底部多出一段，
   行距变成「图 + 间距 + 文字 + 间距」，与有赞对不上。 */
.bc-it {
  color: var(--bc-ifg, var(--color-text));
  /*
   * 标题行盒高度按有赞的**绝对值 18px**（实测：字号 14px 时 computed
   * line-height = 18px，条目高 119.54+10+18 = 147.54）。
   * 不写这一条时是 `line-height: normal`，实测行盒 20px —— 而且 `normal`
   * 随字体/引擎变化（真机、装修台预览、/preview 三者可能各不相同），
   * 会让「后台看到的行距」与真机不一致。有赞这个值也是固定的 18px，
   * 不跟着字号走，这里保持同样口径（字号调大时同样可能被裁，与有赞一致）。
   */
  line-height: 18px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bc-id {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「单图布局 = 导航」：小图 + 文字左右并排 */
.bc-cell.nav {
  display: flex;
  align-items: center;
}
.bc-cell.nav .bc-pic {
  margin-right: 16rpx;
}
.bc-cell.nav .bc-txt {
  flex: 1;
}
.bc-cell.nav .bc-it {
  margin-top: 0;
  text-align: left;
}
.bc-cell.nav .bc-id {
  text-align: left;
}

.bc-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 分类图缓动：四种效果 + 逐条延迟（延迟由 JS 按 index 算好放进 inline style） */
.bc-cell.anim-right,
.bc-cell.anim-up,
.bc-cell.anim-zoom,
.bc-cell.anim-fade {
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}
.bc-cell.anim-right { animation-name: bc-in-right; }
.bc-cell.anim-up { animation-name: bc-in-up; }
.bc-cell.anim-zoom { animation-name: bc-in-zoom; }
.bc-cell.anim-fade { animation-name: bc-in-fade; }
@keyframes bc-in-right {
  from { opacity: 0; transform: translateX(60rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes bc-in-up {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bc-in-zoom {
  from { opacity: 0; transform: scale(.86); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes bc-in-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ============================================================
   有赞基础/高级组件余下 37 项（依赖型 + 展示型）的统一外观
   —— 与 templates/blocks.wxml 的 `block.fam` 分支一一对应。
   设计口径：中性的「配置卡片」，把运营配了什么如实显示出来；
   底部固定一行「依赖 XX · 仅占位展示」，避免运营以为真机已经跑起来了。
   ============================================================ */
.c-yz {
  box-sizing: border-box;
  background: var(--color-bg-card);
}

.yz-hd {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  padding: 8rpx 0 12rpx;
}

.yz-pic {
  display: block;
  width: 100%;
  background: var(--color-bg-muted);
}

.yz-pic.round { border-radius: var(--radius-base); }

.yz-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: 12rpx 0 0;
}

.yz-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 0 var(--space-lg);
  height: 60rpx;
  line-height: 60rpx;
  font-size: var(--font-base);
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-radius: var(--radius-lg);
}

/* 依赖标注：只在「本体依赖外部业务系统」的组件上出现，别套到能真跑的组件上 */
.yz-dep {
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  font-size: var(--font-xs);
  line-height: 1.5;
  color: var(--color-warning);
  background: var(--color-bg-muted);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

/* ==================== 商品分组（真跑：分类菜单 + 该分组商品） ==================== */
.c-grp { box-sizing: border-box; }
.cgp-menu {
  white-space: nowrap;
  display: flex;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.cgp-menu.left { flex-direction: column; }
.cgp-tab {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}
.cgp-tab.on {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--color-primary);
}
.cgp-menu.left .cgp-tab.on { border-bottom: 0; border-left: 6rpx solid var(--color-primary); }
.cgp-list { display: flex; flex-wrap: wrap; }
.cgp-cell { box-sizing: border-box; padding: 8rpx; }

/* ==================== 店铺热搜（真跑：词表在装修台里配） ==================== */
.c-hotw { padding: 16rpx var(--space-base); }
.chw-hd { display: flex; align-items: center; }
.chw-badge {
  flex: 0 0 auto;
  margin-right: 8rpx;
  padding: 0 8rpx;
  font-size: var(--font-xs);
  line-height: 32rpx;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-radius: var(--radius-sm);
}
.chw-title { font-size: var(--font-base); font-weight: 600; color: var(--color-text); }
.chw-list { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chw-list.single { flex-wrap: nowrap; overflow: hidden; }
.chw-word {
  margin: 0 16rpx 12rpx 0;
  padding: 6rpx 20rpx;
  font-size: var(--font-sm);
  background: var(--color-bg-muted);
  border-radius: var(--radius-lg);
}
