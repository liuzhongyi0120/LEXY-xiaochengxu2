/* ==================== 页面与通用区块 ==================== */
.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
}

.block-wrap {
  display: block;
  box-sizing: border-box;
}

/* 区块内图片 */
.bi {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.biw {
  width: 100%;
  display: block;
  background: var(--color-bg-muted);
}
.bv {
  width: 100%;
  display: block;
}
.round {
  border-radius: 16rpx;
  overflow: hidden;
}

/* 轮播 */
.sw {
  width: 100%;
}
.sw-cell {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}
.num-ind {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  background: rgba(0, 0, 0, .38);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

/* 横向滑动 */
.hscroll {
  width: 100%;
  white-space: nowrap;
}
.hscroll-i {
  width: 560rpx;
  display: inline-block;
  vertical-align: top;
  background: var(--color-bg-muted);
}

/* 双层轮播缩略图 */
.thumb-row {
  white-space: nowrap;
  margin-top: 12rpx;
}
.thumb-i {
  width: 110rpx;
  height: 110rpx;
  display: inline-block;
  margin-right: 10rpx;
  border-radius: 8rpx;
  opacity: .6;
  border: 2rpx solid transparent;
  background: var(--color-bg-muted);
}
.thumb-i.on {
  opacity: 1;
  border-color: var(--color-primary);
}

/* ==================== 标题文本 ==================== */
.c-title {
  box-sizing: border-box;
}
.ct-main {
  line-height: 1.4;
}
.ct-main.s-sm { font-size: 26rpx; }
.ct-main.s-md { font-size: 32rpx; }
.ct-main.s-lg { font-size: 40rpx; }
.ct-main.bold { font-weight: 600; }
.ct-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 辅助分割 ==================== */
.ln {
  border-top-style: solid;
  border-top-color: var(--color-border);
}
.ln.dashed { border-top-style: dashed; }

/* ==================== 公告 ==================== */
.c-notice {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}
.cn-icon { margin-right: 10rpx; }
.cn-text {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cn-scroll { flex: 1; height: 64rpx; }

/* ==================== 图文导航 ==================== */
.c-nav {
  display: flex;
  flex-wrap: wrap;
}
.cn-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}
.cn-i {
  display: block;
}
.cn-t {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

/* ==================== 魔方 ==================== */
.c-cube {
  display: flex;
  flex-wrap: wrap;
}
.cc-cell {
  box-sizing: border-box;
}
.cc-img {
  width: 100%;
  height: 220rpx;
  display: block;
  border-radius: 8rpx;
  background: var(--color-bg-muted);
}

/* ==================== 热区切图 ==================== */
.hs-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.hs-area {
  position: absolute;
  z-index: 2;
}

/* ==================== 店铺信息 ==================== */
.c-shop {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.cs-av {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: var(--color-bg-muted);
}
.cs-txt {
  display: flex;
  flex-direction: column;
}
.cs-n {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.cs-s {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 商品 ==================== */
.c-goods {
  box-sizing: border-box;
}
.cg-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  padding: 24rpx 0 12rpx;
}
.cg-grid {
  display: flex;
  flex-wrap: wrap;
}
.cg-cell {
  box-sizing: border-box;
  padding: 8rpx;
}
.cg-card {
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .05);
}
.cg-img {
  width: 100%;
  height: 320rpx;
  display: block;
  background: var(--color-bg-muted);
}
/* 商品图加载失败时的降级色块 */
.cg-img-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}
.cg-info {
  padding: 12rpx;
}
.cg-name {
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cg-price {
  margin-top: 8rpx;
  color: var(--color-price);
}
.cg-cur { font-size: 22rpx; }
.cg-num { font-size: 32rpx; font-weight: 600; }
.cg-buy {
  margin-top: 10rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-radius: 26rpx;
}
.cg-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

/* ==================== 页面级店铺信息（原有） ==================== */
.shop {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 24rpx;
}
.shop-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-muted);
}
.shop-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.shop-slogan {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 区块锚点（电梯导航定位用） ==================== */
.blk {
  display: block;
}

/* ==================== 富文本 ==================== */
.c-rich {
  display: block;
}
.cr-body {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text);
  line-height: 1.7;
  word-break: break-all;
}

/* ==================== 商品搜索 ==================== */
.c-search {
  display: block;
}
.cs-box {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 6rpx;
  overflow: hidden;
}
.cs-box.round {
  border-radius: 999rpx;
}
.cs-ico {
  font-size: 26rpx;
  margin-right: 10rpx;
}
.cs-ph {
  flex: 1;
  font-size: var(--font-sm);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cs-scan {
  flex: 0 0 auto;
  margin-left: 10rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* ==================== 电梯导航 ==================== */
.c-elev {
  display: block;
}
.ce-scroll {
  white-space: nowrap;
  width: 100%;
}
.ce-tag {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  font-size: var(--font-sm);
  margin-right: 8rpx;
}
/* 标签风格：背景模式 / 圆框 / 方框 / 下划线（与有赞四选一一致） */
.ce-tag.bg.on {
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}
.ce-tag.round {
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}
.ce-tag.round.on {
  border-color: var(--color-primary);
}
.ce-tag.square {
  border: 1rpx solid var(--color-border);
  border-radius: 6rpx;
}
.ce-tag.square.on {
  border-color: var(--color-primary);
}
.ce-tag.underline {
  border-bottom: 4rpx solid transparent;
}
.ce-tag.underline.on {
  border-bottom-color: var(--color-primary);
}
.ce-drop {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
}
.ce-dropitem {
  font-size: var(--font-sm);
  padding: 8rpx 20rpx;
}

/* ==================== 进入店铺 / 在线客服（按钮行） ==================== */
.c-btnrow {
  display: flex;
  align-items: center;
}
.cbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  height: 72rpx;
  padding: 0 40rpx;
  font-size: var(--font-base);
  border-radius: 6rpx;
  line-height: 1;
  margin: 0;
}
.cbtn::after {
  border: none;
}
.cbtn.round {
  border-radius: 999rpx;
}

/* ==================== 语音 ==================== */
.c-audio {
  display: flex;
  align-items: center;
}
.c-audio.right {
  flex-direction: row-reverse;
}
.ca-av {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg-muted);
  flex: none;
}
.ca-bubble {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 20rpx;
  padding: 18rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
}
.ca-text {
  font-size: var(--font-sm);
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ca-dur {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}
.ca-ico {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-left: 12rpx;
}

/* ==================== 内容卡片 ==================== */
.c-ccard {
  display: block;
}
.cc-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  padding: 8rpx 4rpx 16rpx;
}
.cc-grid {
  display: flex;
  flex-wrap: wrap;
}
.cc-cell {
  box-sizing: border-box;
  padding: 8rpx;
}
.cc-card {
  overflow: hidden;
  background: var(--color-bg-card);
}
.cc-card.shadow {
  border-radius: var(--radius-base);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .06);
}
.cc-card.white {
  border-radius: 0;
}
.cc-card.plain {
  background: transparent;
}
.cc-pic {
  position: relative;
  width: 100%;
  height: 0;
  background: var(--color-bg-muted);
  overflow: hidden;
}
.cc-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.cc-body {
  padding: 16rpx;
}
.cc-t {
  font-size: var(--font-base);
  color: var(--color-text);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cc-d {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cc-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}
.cc-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}
.cc-m {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-right: 16rpx;
}
.cc-more {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  padding: 20rpx 0 4rpx;
}

/* ==================== 购买按钮（固定吸底） ==================== */
.cb-spacer {
  width: 100%;
}
.c-buybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
}
.cb-row {
  display: flex;
  align-items: center;
  height: 100%;
  box-sizing: border-box;
}
.cb-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 300rpx;
  padding: 0 60rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}

/* ==================== 品牌分类（对标有赞「高级组件 · 品牌分类E」） ==================== */
/* 左栏品牌导航 + 右栏图文；5 种标题风格的差异全部靠 class + CSS 变量表达，
   具体取值由 utils/blocks.js 算好放进 inline style（模板里不做任何算术）。 */
.c-bcat {
  position: relative;
  overflow: hidden;
}
.bc-wrap {
  display: flex;
  align-items: stretch;
}
.bc-navcol {
  flex: 0 0 auto;
  overflow: hidden;
}

/* 左栏顶部：Logo / 搜索框 */
.bc-logo {
  padding: 12rpx;
}
.bc-logo image {
  width: 100%;
  display: block;
}
.bc-search {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(0, 0, 0, .06);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 导航项：外层负责间距 / 分隔线，内层负责色块与文字 */
.bc-nav {
  position: relative;
  box-sizing: border-box;
}
.bc-nav.is-d {
  border-bottom: 1rpx solid var(--bc-line, #DDDDDD);
}
.bc-navi {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  overflow: hidden;
  background: var(--bc-bg, transparent);
  color: var(--bc-fg, #050505);
  font-weight: var(--bc-w, 300);
}
.bc-navi.on {
  background: var(--bc-bg-on, #000000);
  color: var(--bc-fg-on, #FFFFFF);
  font-weight: var(--bc-w-on, 450);
}
/* 风格 C：跟随选中项的左侧竖条（高度 / 宽度 / 颜色都可配） */
.bc-navi.is-c.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: var(--bc-bar-w, 2rpx);
  height: var(--bc-bar-h, 20rpx);
  margin-top: -1rpx;
  transform: translateY(-50%);
  background: var(--bc-bar, #000000);
}
.bc-navt {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.25;
}

/* 右栏 */
.bc-main {
  position: relative;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}
.bc-bgimg {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: top center;
  background-repeat: no-repeat;
}
.bc-bgtop {
  height: 56rpx;
}
.bc-inner {
  position: relative;
}
.bc-ptitle {
  color: var(--bc-pfg, var(--color-text));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bc-grid {
  display: flex;
  flex-wrap: wrap;
}
.bc-cell {
  box-sizing: border-box;
}

/* 分类图：网格模式按原图比例撑高（widthFix），导航模式固定方形 */
.bc-pic {
  position: relative;
  overflow: hidden;
  background: var(--color-bg-muted);
}
.bc-pic.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .16);
}
.bc-pic image {
  width: 100%;
  display: block;
}
.bc-pic.square {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid var(--bc-ibd, transparent);
}
.bc-pic.square image {
  height: 100%;
}
.bc-picph {
  padding: 24rpx 0;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.bc-txt {
  min-width: 0;
}
.bc-it {
  margin-top: 8rpx;
  color: var(--bc-ifg, var(--color-text));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bc-id {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「单图布局 = 导航」：小图 + 文字左右并排 */
.bc-cell.nav {
  display: flex;
  align-items: center;
}
.bc-cell.nav .bc-pic {
  margin-right: 16rpx;
}
.bc-cell.nav .bc-txt {
  flex: 1;
}
.bc-cell.nav .bc-it {
  margin-top: 0;
  text-align: left;
}
.bc-cell.nav .bc-id {
  text-align: left;
}

.bc-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 分类图缓动：四种效果 + 逐条延迟（延迟由 JS 按 index 算好放进 inline style） */
.bc-cell.anim-right,
.bc-cell.anim-up,
.bc-cell.anim-zoom,
.bc-cell.anim-fade {
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}
.bc-cell.anim-right { animation-name: bc-in-right; }
.bc-cell.anim-up { animation-name: bc-in-up; }
.bc-cell.anim-zoom { animation-name: bc-in-zoom; }
.bc-cell.anim-fade { animation-name: bc-in-fade; }
@keyframes bc-in-right {
  from { opacity: 0; transform: translateX(60rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes bc-in-up {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bc-in-zoom {
  from { opacity: 0; transform: scale(.86); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes bc-in-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
