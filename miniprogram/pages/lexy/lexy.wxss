.page {
  background: var(--color-bg-card);
  min-height: 100vh;
  padding-bottom: 32rpx;
}

/* ---------- 系列头图 ---------- */
.hero {
  position: relative;
  width: 100%;
  height: 750rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-fallback {
  width: 100%;
  height: 100%;
  background: #f2f0ec;
}

.hero-mask {
  position: absolute;
  left: 0;
  bottom: 60rpx;
  padding: 0 0 0 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-title {
  margin-left: 24rpx;
  font-size: 36rpx;
  color: var(--color-text-inverse);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}

.hero-sub {
  margin-left: 24rpx;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--color-text-inverse);
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.25);
}

.hero-tag {
  margin-left: 284rpx;
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--color-text-inverse);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

/* ---------- 商品横滑 ---------- */
.row {
  width: 100%;
  margin-top: 40rpx;
  white-space: nowrap;
}

.row-inner {
  display: inline-flex;
  padding: 0 0 0 0;
}

.card {
  width: 300rpx;
  margin-left: 10rpx;
  background: var(--color-bg-card);
  border-radius: 8rpx;
  overflow: hidden;
}

.card:first-child {
  margin-left: 0;
}

.card-hover {
  opacity: 0.88;
}

.card-img {
  width: 100%;
  display: block;
  background: var(--color-bg-muted);
}

.card-fallback {
  width: 300rpx;
  height: 488rpx;
  background: var(--color-bg-muted);
}
