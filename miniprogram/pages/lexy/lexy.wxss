.page {
  background: var(--color-bg-card);
  min-height: 100vh;
  /*
   * 底部必须给自定义 tabBar 让位（2026-10-17 真机反馈：莱克页内容显示不完全）。
   * tabBar 高 50px = 100rpx，再加底部安全区（iPhone 全面屏还有 34px 左右）；
   * 原来只留 32rpx，最后一组系列卡片被导航盖住一截。
   * 口径与 custom-tab-bar/index.wxss 的 .tb、custom/index.wxss 的 .tabbar-hold 保持一致。
   */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ---------- 系列头图 ---------- */
.hero {
  position: relative;
  width: 100%;
  height: 750rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-fallback {
  width: 100%;
  height: 100%;
  background: #f2f0ec;
}

.hero-mask {
  position: absolute;
  left: 0;
  bottom: 60rpx;
  padding: 0 0 0 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-title {
  margin-left: 24rpx;
  font-size: 36rpx;
  color: var(--color-text-inverse);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}

.hero-sub {
  margin-left: 24rpx;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--color-text-inverse);
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.25);
}

/*
 * 系列名靠右：原来写死 margin-left: 284rpx —— 那个数是按 375 屏宽拍的，
 * 屏宽一变（大屏 / 平板）就会跟着漂，窄屏上还会顶出边界。改成靠右对齐自适应。
 */
.hero-tag {
  align-self: flex-end;
  margin-right: 24rpx;
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--color-text-inverse);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

/* ---------- 商品横滑 ---------- */
.row {
  width: 100%;
  margin-top: 40rpx;
  white-space: nowrap;
}

.row-inner {
  display: inline-flex;
  padding: 0 0 0 0;
}

.card {
  width: 300rpx;
  margin-left: 10rpx;
  background: var(--color-bg-card);
  border-radius: 8rpx;
  overflow: hidden;
}

.card:first-child {
  margin-left: 0;
}

.card-hover {
  opacity: 0.88;
}

.card-img {
  width: 100%;
  display: block;
  background: var(--color-bg-muted);
}

.card-fallback {
  width: 300rpx;
  height: 488rpx;
  background: var(--color-bg-muted);
}
