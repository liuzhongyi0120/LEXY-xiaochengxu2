.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--color-bg-card);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: 34rpx;
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border: 3rpx solid var(--color-text-secondary);
  border-radius: 50%;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  background: var(--color-text-secondary);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

.search-ph {
  color: var(--color-text-secondary);
}

.search-clear {
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--color-text-placeholder);
}

.search-cancel {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

/* ---------- 搜索历史 ---------- */
.history {
  padding: 24rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-title {
  font-size: 28rpx;
  color: var(--color-text);
}

.history-clear {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.history-tag {
  margin: 0 16rpx 16rpx 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: #444441;
  background: var(--color-bg-card);
  border-radius: 28rpx;
}

.history-empty {
  display: block;
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---------- 排序栏 ---------- */
.sort-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
}

.sort-item {
  display: flex;
  align-items: center;
  margin-right: 44rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.sort-item.is-active {
  color: var(--color-primary);
  font-weight: 600;
}

.sort-arrow {
  margin-left: 6rpx;
  font-size: 22rpx;
}

.sort-count {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ---------- 商品网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 0;
}

.grid-item {
  width: 340rpx;
  margin-bottom: 20rpx;
}

.grid-item:nth-child(odd) {
  margin-right: 20rpx;
}

/* ---------- 骨架屏（底色/动效走 app.wxss 的 .skeleton，这里只管尺寸） ---------- */
.sk-img {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.sk-line {
  height: 28rpx;
  margin: 20rpx 20rpx 0;
}

.sk-short {
  width: 40%;
  margin-bottom: 20rpx;
}

/* ---------- 加载更多 ---------- */
.load-more {
  padding: 24rpx 0;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
