/* 全局设计变量：颜色 / 字号 / 间距 / 圆角
   品牌色为占位值，请用莱克品牌 VI 主色替换后统一生效 */
page {
  /* ---------- 品牌色 ---------- */
  --color-primary: #C8102E;          /* TODO 替换为品牌 VI 主色 */
  --color-primary-light: #FDECEE;    /* 主色浅底，用于标签、选中态 */
  --color-price: #C8102E;            /* 价格文字色 */

  /* ---------- 功能色 ---------- */
  --color-danger: #EE0A24;
  --color-warning: #FF976A;
  --color-success: #07C160;

  /* ---------- 文字 ---------- */
  --color-text: #323233;
  --color-text-secondary: #969799;
  --color-text-placeholder: #C8C9CC;
  --color-text-inverse: #FFFFFF;

  /* ---------- 背景与描边 ---------- */
  --color-bg: #F5F5F5;
  --color-bg-card: #FFFFFF;
  --color-bg-muted: #F2F3F5;         /* 图片占位、浅底色块 */
  --color-bg-hover: #EBEDF0;         /* 点击态底色（按钮 / 步进器） */
  --color-disabled: #D8D8D8;         /* 禁用态底色 */
  --color-border: #EBEDF0;

  /* ---------- 字号 ---------- */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;

  /* ---------- 间距 ---------- */
  --space-sm: 16rpx;
  --space-base: 24rpx;
  --space-lg: 32rpx;

  /* ---------- 圆角 ---------- */
  --radius-sm: 8rpx;
  --radius-base: 16rpx;
  --radius-lg: 24rpx;

  /* ---------- 品牌分类组件（对标有赞「高级组件 · 品牌分类E」）----------
     这一组不是全局主题令牌，而是**组件级令牌**：真实取值由装修数据决定，
     每渲染一次都由 utils/blocks.js 写进元素的 inline style（选中 / 未选两套值）。
     在这里给出兜底默认值有两个作用：
       1) 装修数据缺字段时不会让颜色静默失效（取值缺失会整条声明作废）；
       2) 让「样式里引用的令牌必须有定义」的静态自检有据可依 —— 组件级令牌也是令牌。 */
  --bc-fg: #050505;              /* 标题色（未选） */
  --bc-fg-on: #FFFFFF;           /* 标题选中色 */
  --bc-bg: transparent;          /* 未选底色（风格 A / E 才不是透明） */
  --bc-bg-on: #000000;           /* 选中底色 */
  --bc-w: 300;                   /* 默认字重 */
  --bc-w-on: 450;                /* 选中字重 */
  --bc-bar: #000000;             /* 风格 C 的竖条颜色 */
  --bc-bar-w: 2rpx;              /* 风格 C 的竖条宽度 */
  --bc-bar-h: 20rpx;             /* 风格 C 的竖条高度 */
  --bc-line: #DDDDDD;            /* 风格 D 的分隔线 */
  --bc-ifg: #323233;             /* 分类标题色 */
  --bc-pfg: #323233;             /* 小组标题色 */
  --bc-ibd: transparent;         /* 导航模式下的分类图边框色 */
}
